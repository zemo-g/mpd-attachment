-- rail/mpd_solver.rail -- Phase 2 solver: axisymmetric resistive MHD with
-- Hall term, azimuthal-only self-field B_theta, attachment PRESCRIBED as
-- B_theta Dirichlet faces (rail/mhd_pbt.rail).
--
-- Dependencies (import order in the runner, no dedupe):
--   rail/pbt.rail, rail/mhd_pbt.rail, rail/stress_diag.rail, this file.
-- The RUNNER must define: run_hall (1.0 on / 0.0 off).
--
-- Scheme notes (deliberate, see program.md phase 2):
--   Fluxes carry total pressure p_t = p + B^2/2mu0; the ONLY momentum
--   sources are the axisym geometric ones:
--     d(rho)/dt += -rho v_r / r
--     d(m_r)/dt += -m_r v_r / r - B^2/(mu0 r)     (hoop tension)
--     d(m_z)/dt += -m_z v_r / r
--     d(E)/dt   += -(E + p_t) v_r / r
--   No explicit J x B source: with azimuthal-only B the Lorentz force IS
--   the Maxwell stress already present in flux + hoop. (The stdlib
--   mhd_mpd.rail pack double-counts this; deliberately not reused.)
--   B_theta axial flux is +v_z B_theta (divergence-form advection; the
--   stdlib core's -v_z B_theta is an in-plane-B holdover).
--   Non-ideal induction, resistive part: operator-split IMPLICIT
--   diffusion (Thomas tridiagonal per z-line then per r-line, done
--   in-place on st before the hyperbolic update). Unconditionally stable:
--   every explicit form detonates at dr=0.5mm because the resistive layer
--   sqrt(eta t / mu0) ~ 0.4mm is sub-cell against pinned Dirichlet faces
--   (three A/B-isolated attempts, 2026-08-31). Prescribed faces fold into
--   the tridiagonal (ghost = 2 face - cell absorbed into diag/rhs, so no
--   ghost feedback loop); the axis face uses the linear-B regularization
--   g = 2B/r (exact for B ~ r). Energy: en += (B dB + dB^2/2)/mu0 at each
--   sweep write (telescopes to the exact magnetic-energy change, so p is
--   untouched by field transport) plus explicit Ohmic heating dt eta j^2.
--   Hall + grad-pe stay explicit (whistler dt) and p-absorbing, as before.
--   eta = Spitzer + electron-neutral (mv_eta_calc) capped to [1e-7, 1e-3];
--   Hall density floor n_hall = 1e19 m^-3 (standard vacuum clamp).
--   EOS: Saha single-ionization argon (the ionization energy sink) - see
--   the eos_* block. grad-pe still uses pe = p/2 (full-ionization limit);
--   refine to p alpha/(1+alpha) when Hall goes implicit (P2).

gamma_m1 = 0.6666666666666667
e_charge = 1.602176634e-19
m_ion_ar = 6.633e-26
-- cfl-sensitivity finding (2026-09-01, out/phase2_cfl15.log vs pf3):
-- the 8 kA / 6 g/s runaway REVERSES at cfl 0.15 (doubled LxF numerical
-- dissipation). No fate conclusion is valid at this scheme/resolution
-- unless it is cfl-INVARIANT; see notes/pion_chain_log.md.
cfl_c = 0.30
-- eta bounds are NUMERIC only since the partially-ionized law
-- (2026-09-01): the old 2e-5 "physical band" cap bound in 100% of cells
-- at the cold Saha steady state and throttled Ohmic input to 7 kW
-- against a ~400 kW arc, erasing arc-constriction physics entirely
eta_cap = 1.0e-3
eta_floor = 1.0e-7
n_hall_floor = 1.0e19

-- ── wall energy sink (2026-09-01, shipped AFTER the fate verdict) ──
-- Adiabatic walls were the dominant omitted dissipation: conduction to
-- cold electrodes/walls is 16x-160x total Ohmic across the kappa band
-- [0.3, 3] W/m/K (tools/sink_estimate.py on the pf2 state). First cut
-- is a constant effective conductivity so the band is bracketed by ONE
-- constant; T-dependent kappa only if the verdict turns borderline.
-- Per step and cell the removal is capped at half the thermal energy.
-- fb slot 40 accumulates the Joules removed (the counter ships WITH
-- the sink, not after it).
kappa_wall = 1.0
t_wall = 300.0

-- inlet (argon 6 g/s, 54% annulus / 46% ring, 300 m/s, 300 K)
in_v = 300.0
-- The inlet face is a PRESCRIBED FLUX (2026-09-01, replacing the
-- flux-metered ghost). A choked injector fed by a mass-flow controller
-- delivers its mass flow independent of downstream pressure, so the
-- face carries exactly rho_in v_in (mass), rho_in v_in^2 + p_in
-- (momentum), (e_in + p_in) v_in (energy) in EVERY regime, vacuum
-- included. The old ghost copied the fluid density and reflected the
-- momentum around the nominal; its velocity cap, gated on near-vacuum
-- fluid, still engaged in every second-order segment (half the inlet
-- rows delivering 5% of nominal, mdot_in 6.0e-3 -> 2.87e-3) because the
-- less-diffusive scheme evacuates the near-inlet region. See
-- mv_face_zin. The mask-6 ghost is now a plain reservoir state (used
-- only by the field sweeps and the bt boundary).
in_rho_ann = 0.014707
in_rho_ring = 0.0064220
kT_m = 62444.0

rho_floor = 0.00000001
amb_rho = 0.00003
amb_p = 1.0

-- ── Saha EOS (argon, single ionization; added 2026-09-01, P1) ──
-- The ionization energy sink. en stays the conserved total energy and the
-- transport keeps its conservative form untouched; the sink lives entirely
-- in the EOS map e_int -> p: energy locked in ionization potential exerts
-- no pressure, and recombination returns it downstream automatically.
--   p     = (1 + alpha) n k T          (n = rho/m_ion, heavy particles)
--   e_int = 1.5 (1 + alpha) n k T + alpha n chi
--   Saha:   alpha^2/(1-alpha) = S(T)/n
--   S(T)  = 2 (U_i/U_0) (2 pi m_e k T / h^2)^1.5 exp(-chi/kT)
-- U_i/U_0 = 6 (Ar+ 2P both fine levels vs Ar 1S0; single-T, no excitation
-- energy, no double ionization - noted limitations). Stable closed form
-- alpha = 2 / (1 + sqrt(1 + 4 n / S)) holds for all S. The inversion
-- e_int -> T is a monotone bisection on the exact bracket
-- [(e - n chi)/(3 n k), e/(1.5 n k)]. Below 2500 K alpha < 1e-10 at any
-- density down to rho_floor, so cold cells take an exact ideal branch and
-- never pay the exp.
k_boltz = 1.380649e-23
chi_ar = 2.5249680505129372e-18
chi_over_k = 182882.69143808
saha_c = 2.8976196474863585e22

eos_alpha n t =
  if t < 2500.0 then 0.0
  else
    let s = saha_c * t * sqrt t * exp (0.0 - chi_over_k / t)
    2.0 / (1.0 + sqrt (1.0 + 4.0 * n / s))

eos_e n t =
  let a = 1.0 * eos_alpha n t
  1.5 * (1.0 + a) * n * k_boltz * t + a * n * chi_ar

-- Bisection with every loop invariant hoisted into the args (exactly 8,
-- the TCO limit): a reference to a TOP-LEVEL float constant compiles to
-- a runtime atof of its literal (~50ns + a locale lock), measured
-- 2026-09-01 - four such references per iteration made the first Saha
-- binary spend a third of its time in strtod. Inline literals and args
-- are free; only named-constant references pay.
--   cn = 4 n / saha_c,  ck = chi_over_k,  ek = 1.5 n k,  ic = n chi
eos_temp_bi cn ck ek ic eint tl th it =
  if it >= 24 then 0.5 * (tl + th)
  else
    let tm = 0.5 * (tl + th)
    let a = if tm < 2500.0 then 0.0 else
        let s = tm * sqrt tm * exp (0.0 - ck / tm)
        2.0 / (1.0 + sqrt (1.0 + cn / s))
    let em = ek * tm * (1.0 + a) + ic * a
    if em < eint then eos_temp_bi cn ck ek ic eint tm th (it + 1)
    else eos_temp_bi cn ck ek ic eint tl tm (it + 1)

eos_temp n eint =
  let kb = 1.0 * k_boltz
  let ek = 1.5 * n * kb
  let th = eint / ek
  if th < 2500.0 then th
  else
    let ic = n * chi_ar
    let tl_raw = (eint - ic) / (2.0 * ek)
    let tl = if tl_raw < 300.0 then 300.0 else tl_raw
    let cn = 4.0 * n / saha_c
    let ck = 1.0 * chi_over_k
    eos_temp_bi cn ck ek ic eint tl th 0

-- floored thermal energy density e_int = en - ke - me (floor matches the
-- old p >= 1e-6 floor: gamma_m1 * 1.5e-6 = 1e-6)
mv_eint st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let e = mp_get st mp_f_en j i
  let ke = 0.5 * (mr * mr + mz * mz) / rho_safe
  let me = 0.5 * bt * bt * inv_mu0
  let ei = e - ke - me
  if ei < 0.0000015 then 0.0000015 else ei

-- ── pressure/speed on state (rho floor + e_int floor) ──
mv_pressure st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let ei = 1.0 * mv_eint st j i
  let n = rho_safe / m_ion_ar
  let t = 1.0 * eos_temp n ei
  let a = 1.0 * eos_alpha n t
  if a < 1.0e-10 then gamma_m1 * ei
  else (1.0 + a) * n * k_boltz * t

-- 5/3 p/rho OVER-estimates c_s once ionization bites (gamma_eff < 5/3
-- in the Saha band), so the CFL built on it stays safe
mv_speed st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let p = mv_pressure st j i
  let a2 = 1.6666666666666667 * p / rho_safe
  let va2 = bt * bt * inv_mu0 / rho_safe
  let v2 = (mr * mr + mz * mz) / (rho_safe * rho_safe)
  sqrt v2 + sqrt (a2 + va2)

-- ── fluxes ──
-- fb is a single 20-float scratch: offsets 0 r-plus, 5 r-minus, 10 z-plus,
-- 15 z-minus (one allocation per run; keeps loop arity <= 8 for TCO)
-- ── MUSCL face machinery (2026-09-01 second-order upgrade) ──
-- Faces carry S = F(U_L) + F(U_R) (central sum) and d = U_R - U_L
-- (dissipation jump). With zero slopes this is EXACTLY the old scheme:
-- S degenerates to F_c + F_nb and d to U_nb - U_c. Reconstruction is
-- piecewise-linear with minmod on rho, mr, mz, en, bt AND the cached p
-- (p reconstructed directly so no EOS inversion happens per face).
-- A face whose 4-cell stencil touches ANY non-fluid cell drops to first
-- order, so every ghost cancellation property (metered inlet, mirrors,
-- audit boundary fluxes) is preserved EXACTLY at boundaries.
-- fb layout is now 40: S at 0/5/10/15 (r+ r- z+ z-), d at 20/25/30/35.

-- minmod: the most diffusive TVD limiter, deliberately - safety first.
-- (Equivalence of the zero-slope refactor vs the pre-refactor binary
-- was verified at 8.9e-12 over 200 steps before this went live.)
mv_mm a b =
  if a > 0.0 then
    if b > 0.0 then if a < b then a else b else 0.0
  else
    if b < 0.0 then if a > b then a else b else 0.0

mv_recl q0 q1 q2 =
  let sl = 1.0 * mv_mm (q1 - q0) (q2 - q1)
  q1 + 0.5 * sl

mv_recr q1 q2 q3 =
  let sl = 1.0 * mv_mm (q2 - q1) (q3 - q2)
  q2 - 0.5 * sl

mv_fb_zero5 fb off =
  let _ = float_arr_set fb off 0.0
  let _ = float_arr_set fb (off + 1) 0.0
  let _ = float_arr_set fb (off + 2) 0.0
  let _ = float_arr_set fb (off + 3) 0.0
  float_arr_set fb (off + 4) 0.0

mv_fr_add fb off rho mr mz en bt p =
  let rs = if rho < rho_floor then rho_floor else rho
  let vr = mr / rs
  let pt = p + 0.5 * bt * bt * inv_mu0
  let _ = float_arr_set fb off (float_arr_get fb off + mr)
  let _ = float_arr_set fb (off + 1) (float_arr_get fb (off + 1) + mr * vr + pt)
  let _ = float_arr_set fb (off + 2) (float_arr_get fb (off + 2) + mz * vr)
  let _ = float_arr_set fb (off + 3) (float_arr_get fb (off + 3) + (en + pt) * vr)
  float_arr_set fb (off + 4) (float_arr_get fb (off + 4) + vr * bt)

mv_fz_add fb off rho mr mz en bt p =
  let rs = if rho < rho_floor then rho_floor else rho
  let vz = mz / rs
  let pt = p + 0.5 * bt * bt * inv_mu0
  let _ = float_arr_set fb off (float_arr_get fb off + mz)
  let _ = float_arr_set fb (off + 1) (float_arr_get fb (off + 1) + mr * vz)
  let _ = float_arr_set fb (off + 2) (float_arr_get fb (off + 2) + mz * vz + pt)
  let _ = float_arr_set fb (off + 3) (float_arr_get fb (off + 3) + (en + pt) * vz)
  float_arr_set fb (off + 4) (float_arr_get fb (off + 4) + vz * bt)

-- first-order face between (j,i) and (j+1,i)
mv_face_r1 st scr fb j i os od =
  let rha = mp_get st mp_f_rho j i
  let mra = mp_get st mp_f_mr j i
  let mza = mp_get st mp_f_mz j i
  let ena = mp_get st mp_f_en j i
  let bta = mp_get st mp_f_bt j i
  let pa = float_arr_get scr (scr_parr + j * mp_nz + i)
  let rhb = mp_get st mp_f_rho (j + 1) i
  let mrb = mp_get st mp_f_mr (j + 1) i
  let mzb = mp_get st mp_f_mz (j + 1) i
  let enb = mp_get st mp_f_en (j + 1) i
  let btb = mp_get st mp_f_bt (j + 1) i
  let pb = float_arr_get scr (scr_parr + (j + 1) * mp_nz + i)
  let _ = mv_fb_zero5 fb os
  let _ = mv_fr_add fb os rha mra mza ena bta pa
  let _ = mv_fr_add fb os rhb mrb mzb enb btb pb
  let _ = float_arr_set fb od (rhb - rha)
  let _ = float_arr_set fb (od + 1) (mrb - mra)
  let _ = float_arr_set fb (od + 2) (mzb - mza)
  let _ = float_arr_set fb (od + 3) (enb - ena)
  float_arr_set fb (od + 4) (btb - bta)

-- reconstructed face between (j,i) and (j+1,i); stencil j-1..j+2 all fluid
mv_face_r2 st scr fb j i os od =
  let rh0 = mp_get st mp_f_rho (j - 1) i
  let rh1 = mp_get st mp_f_rho j i
  let rh2 = mp_get st mp_f_rho (j + 1) i
  let rh3 = mp_get st mp_f_rho (j + 2) i
  let mr0 = mp_get st mp_f_mr (j - 1) i
  let mr1 = mp_get st mp_f_mr j i
  let mr2 = mp_get st mp_f_mr (j + 1) i
  let mr3 = mp_get st mp_f_mr (j + 2) i
  let mz0 = mp_get st mp_f_mz (j - 1) i
  let mz1 = mp_get st mp_f_mz j i
  let mz2 = mp_get st mp_f_mz (j + 1) i
  let mz3 = mp_get st mp_f_mz (j + 2) i
  let en0 = mp_get st mp_f_en (j - 1) i
  let en1 = mp_get st mp_f_en j i
  let en2 = mp_get st mp_f_en (j + 1) i
  let en3 = mp_get st mp_f_en (j + 2) i
  let bt0 = mp_get st mp_f_bt (j - 1) i
  let bt1 = mp_get st mp_f_bt j i
  let bt2 = mp_get st mp_f_bt (j + 1) i
  let bt3 = mp_get st mp_f_bt (j + 2) i
  let pp0 = float_arr_get scr (scr_parr + (j - 1) * mp_nz + i)
  let pp1 = float_arr_get scr (scr_parr + j * mp_nz + i)
  let pp2 = float_arr_get scr (scr_parr + (j + 1) * mp_nz + i)
  let pp3 = float_arr_get scr (scr_parr + (j + 2) * mp_nz + i)
  let rhl = 1.0 * mv_recl rh0 rh1 rh2
  let rhr = 1.0 * mv_recr rh1 rh2 rh3
  let mrl = 1.0 * mv_recl mr0 mr1 mr2
  let mrr = 1.0 * mv_recr mr1 mr2 mr3
  let mzl = 1.0 * mv_recl mz0 mz1 mz2
  let mzr = 1.0 * mv_recr mz1 mz2 mz3
  let enl = 1.0 * mv_recl en0 en1 en2
  let enr = 1.0 * mv_recr en1 en2 en3
  let btl = 1.0 * mv_recl bt0 bt1 bt2
  let btr = 1.0 * mv_recr bt1 bt2 bt3
  let prl = 1.0 * mv_recl pp0 pp1 pp2
  let prr = 1.0 * mv_recr pp1 pp2 pp3
  let bad = if rhl < rho_floor then true else if rhr < rho_floor then true
            else if prl < 0.000001 then true else if prr < 0.000001 then true
            else false
  if bad then mv_face_r1 st scr fb j i os od
  else
    let _ = mv_fb_zero5 fb os
    let _ = mv_fr_add fb os rhl mrl mzl enl btl prl
    let _ = mv_fr_add fb os rhr mrr mzr enr btr prr
    let _ = float_arr_set fb od (rhr - rhl)
    let _ = float_arr_set fb (od + 1) (mrr - mrl)
    let _ = float_arr_set fb (od + 2) (mzr - mzl)
    let _ = float_arr_set fb (od + 3) (enr - enl)
    float_arr_set fb (od + 4) (btr - btl)

mv_face_r st scr m fb j i os od =
  let g0 = if j < 1 then 1 else arr_get m ((j - 1) * mp_nz + i)
  let g1 = arr_get m (j * mp_nz + i)
  let g2 = arr_get m ((j + 1) * mp_nz + i)
  let g3 = if j + 2 >= mp_nr then 1 else arr_get m ((j + 2) * mp_nz + i)
  let ok = if g0 == 0 then if g1 == 0 then if g2 == 0 then g3 == 0 else false else false else false
  if ok then mv_face_r2 st scr fb j i os od else mv_face_r1 st scr fb j i os od

-- z-direction twins: face between (j,i) and (j,i+1)
mv_face_z1 st scr fb j i os od =
  let rha = mp_get st mp_f_rho j i
  let mra = mp_get st mp_f_mr j i
  let mza = mp_get st mp_f_mz j i
  let ena = mp_get st mp_f_en j i
  let bta = mp_get st mp_f_bt j i
  let pa = float_arr_get scr (scr_parr + j * mp_nz + i)
  let rhb = mp_get st mp_f_rho j (i + 1)
  let mrb = mp_get st mp_f_mr j (i + 1)
  let mzb = mp_get st mp_f_mz j (i + 1)
  let enb = mp_get st mp_f_en j (i + 1)
  let btb = mp_get st mp_f_bt j (i + 1)
  let pb = float_arr_get scr (scr_parr + j * mp_nz + i + 1)
  let _ = mv_fb_zero5 fb os
  let _ = mv_fz_add fb os rha mra mza ena bta pa
  let _ = mv_fz_add fb os rhb mrb mzb enb btb pb
  let _ = float_arr_set fb od (rhb - rha)
  let _ = float_arr_set fb (od + 1) (mrb - mra)
  let _ = float_arr_set fb (od + 2) (mzb - mza)
  let _ = float_arr_set fb (od + 3) (enb - ena)
  float_arr_set fb (od + 4) (btb - bta)

mv_face_z2 st scr fb j i os od =
  let rh0 = mp_get st mp_f_rho j (i - 1)
  let rh1 = mp_get st mp_f_rho j i
  let rh2 = mp_get st mp_f_rho j (i + 1)
  let rh3 = mp_get st mp_f_rho j (i + 2)
  let mr0 = mp_get st mp_f_mr j (i - 1)
  let mr1 = mp_get st mp_f_mr j i
  let mr2 = mp_get st mp_f_mr j (i + 1)
  let mr3 = mp_get st mp_f_mr j (i + 2)
  let mz0 = mp_get st mp_f_mz j (i - 1)
  let mz1 = mp_get st mp_f_mz j i
  let mz2 = mp_get st mp_f_mz j (i + 1)
  let mz3 = mp_get st mp_f_mz j (i + 2)
  let en0 = mp_get st mp_f_en j (i - 1)
  let en1 = mp_get st mp_f_en j i
  let en2 = mp_get st mp_f_en j (i + 1)
  let en3 = mp_get st mp_f_en j (i + 2)
  let bt0 = mp_get st mp_f_bt j (i - 1)
  let bt1 = mp_get st mp_f_bt j i
  let bt2 = mp_get st mp_f_bt j (i + 1)
  let bt3 = mp_get st mp_f_bt j (i + 2)
  let pp0 = float_arr_get scr (scr_parr + j * mp_nz + i - 1)
  let pp1 = float_arr_get scr (scr_parr + j * mp_nz + i)
  let pp2 = float_arr_get scr (scr_parr + j * mp_nz + i + 1)
  let pp3 = float_arr_get scr (scr_parr + j * mp_nz + i + 2)
  let rhl = 1.0 * mv_recl rh0 rh1 rh2
  let rhr = 1.0 * mv_recr rh1 rh2 rh3
  let mrl = 1.0 * mv_recl mr0 mr1 mr2
  let mrr = 1.0 * mv_recr mr1 mr2 mr3
  let mzl = 1.0 * mv_recl mz0 mz1 mz2
  let mzr = 1.0 * mv_recr mz1 mz2 mz3
  let enl = 1.0 * mv_recl en0 en1 en2
  let enr = 1.0 * mv_recr en1 en2 en3
  let btl = 1.0 * mv_recl bt0 bt1 bt2
  let btr = 1.0 * mv_recr bt1 bt2 bt3
  let prl = 1.0 * mv_recl pp0 pp1 pp2
  let prr = 1.0 * mv_recr pp1 pp2 pp3
  let bad = if rhl < rho_floor then true else if rhr < rho_floor then true
            else if prl < 0.000001 then true else if prr < 0.000001 then true
            else false
  if bad then mv_face_z1 st scr fb j i os od
  else
    let _ = mv_fb_zero5 fb os
    let _ = mv_fz_add fb os rhl mrl mzl enl btl prl
    let _ = mv_fz_add fb os rhr mrr mzr enr btr prr
    let _ = float_arr_set fb od (rhr - rhl)
    let _ = float_arr_set fb (od + 1) (mrr - mrl)
    let _ = float_arr_set fb (od + 2) (mzr - mzl)
    let _ = float_arr_set fb (od + 3) (enr - enl)
    float_arr_set fb (od + 4) (btr - btl)

-- prescribed inlet face: (j,i) is the mask-6 ghost, (j,i+1) the fluid
-- cell. The gas part of S is 2 F_in and the gas jump is 0, so the
-- update delivers exactly F_in dt/dz per step whatever the fluid state
-- (selftest 33). The magnetic parts (bt^2/2mu0 in the momentum flux,
-- bt^2/mu0 v in the energy flux, and the bt component itself) are kept
-- from the ghost/fluid pair exactly as before, so the field boundary is
-- unchanged.
mv_face_zin st scr fb j i os od =
  let _ = mv_face_z1 st scr fb j i os od
  let rho_in = if j <= mp_j_in1b then in_rho_ann else in_rho_ring
  let vin = 0.0 + in_v
  let p_in = rho_in * kT_m
  let e_in = rho_in * kT_m / gamma_m1 + 0.5 * rho_in * vin * vin
  let bta = mp_get st mp_f_bt j i
  let btb = mp_get st mp_f_bt j (i + 1)
  let pm2 = 0.5 * inv_mu0 * (bta * bta + btb * btb)
  let _ = float_arr_set fb os (2.0 * rho_in * vin)
  let _ = float_arr_set fb (os + 1) 0.0
  let _ = float_arr_set fb (os + 2) (2.0 * (rho_in * vin * vin + p_in) + pm2)
  let _ = float_arr_set fb (os + 3) (2.0 * (e_in + p_in) * vin + 2.0 * pm2 * vin)
  let _ = float_arr_set fb od 0.0
  let _ = float_arr_set fb (od + 1) 0.0
  let _ = float_arr_set fb (od + 2) 0.0
  float_arr_set fb (od + 3) 0.0

mv_face_z st scr m fb j i os od =
  let g0 = if i < 1 then 1 else arr_get m (j * mp_nz + i - 1)
  let g1 = arr_get m (j * mp_nz + i)
  let g2 = arr_get m (j * mp_nz + i + 1)
  let g3 = if i + 2 >= mp_nz then 1 else arr_get m (j * mp_nz + i + 2)
  let ok = if g0 == 0 then if g1 == 0 then if g2 == 0 then g3 == 0 else false else false else false
  if ok then mv_face_z2 st scr fb j i os od
  else if g1 == 6 then mv_face_zin st scr fb j i os od
  else mv_face_z1 st scr fb j i os od

-- ── ghost fill for the full state ──
-- gas: mirror with normal momentum negated (free slip). The ghost copies
-- the fluid cell's THERMAL energy e_int directly (EOS-agnostic: equal rho
-- and e_int give equal p under any EOS; ke is sign-invariant, me rebuilt
-- for the ghost's own bt), rather than round-tripping through p.
mv_ghost_gas st jg ig jf fi nsign_r nsign_z btg =
  let rho = mp_get st mp_f_rho jf fi
  let mr = mp_get st mp_f_mr jf fi * nsign_r
  let mz = mp_get st mp_f_mz jf fi * nsign_z
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let ei = 1.0 * mv_eint st jf fi
  let ke = 0.5 * (mr * mr + mz * mz) / rho_safe
  let me = 0.5 * btg * btg * inv_mu0
  let _ = mp_put st mp_f_rho jg ig rho
  let _ = mp_put st mp_f_mr jg ig mr
  let _ = mp_put st mp_f_mz jg ig mz
  let _ = mp_put st mp_f_en jg ig (ei + ke + me)
  mp_put st mp_f_bt jg ig btg

mv_ghost_cell st btp m j i =
  let k = j * mp_nz + i
  let mk = arr_get m k
  if mk == 0 then 0
  else if mk == 3 then
    let btg = 0.0 - mp_get st mp_f_bt 1 i
    mv_ghost_gas st j i 1 i (0.0 - 1.0) 1.0 btg
  else if mk == 4 then
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_nrm2 i
    mv_ghost_gas st j i mp_nrm2 i (0.0 - 1.0) 1.0 btg
  else if mk == 5 then
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j 1
    mv_ghost_gas st j i j 1 1.0 (0.0 - 1.0) btg
  else if mk == 6 then
    -- inlet: reservoir ghost (rho_in, v_in, 300 K). NOT used for the gas
    -- flux any more (mv_face_zin prescribes that face); it feeds the
    -- resistive sweeps, the eta/p caches and the bt boundary only.
    let rho_in = if j <= mp_j_in1b then in_rho_ann else in_rho_ring
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j 1
    let mzg = rho_in * in_v
    let ke = 0.5 * mzg * in_v
    let me = 0.5 * btg * btg * inv_mu0
    let _ = mp_put st mp_f_rho j i rho_in
    let _ = mp_put st mp_f_mr j i 0.0
    let _ = mp_put st mp_f_mz j i mzg
    let _ = mp_put st mp_f_en j i (rho_in * kT_m / gamma_m1 + ke + me)
    mp_put st mp_f_bt j i btg
  else if mk == 7 then
    let btg = 0.0 - mp_get st mp_f_bt j mp_nzm2
    mv_ghost_gas st j i j mp_nzm2 1.0 1.0 btg
  else if mk == 1 then
    if i == mp_i_tip then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_tip1
      mv_ghost_gas st j i j mp_i_tip1 1.0 (0.0 - 1.0) btg
    else if j == mp_j_cath then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_j_fluid0 i
      mv_ghost_gas st j i mp_j_fluid0 i (0.0 - 1.0) 1.0 btg
    else mv_ghost_solid st btp j i
  else
    if j == mp_j_anode then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_j_anodem1 i
      mv_ghost_gas st j i mp_j_anodem1 i (0.0 - 1.0) 1.0 btg
    else if i == mp_i_an0 then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_aif
      mv_ghost_gas st j i j mp_i_aif 1.0 (0.0 - 1.0) btg
    else if i == mp_i_an1 then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_aof
      mv_ghost_gas st j i j mp_i_aof 1.0 (0.0 - 1.0) btg
    else mv_ghost_solid st btp j i

mv_ghost_solid st btp j i =
  let btg = float_arr_get btp (j * mp_nz + i)
  let me = 0.5 * btg * btg * inv_mu0
  let _ = mp_put st mp_f_rho j i amb_rho
  let _ = mp_put st mp_f_mr j i 0.0
  let _ = mp_put st mp_f_mz j i 0.0
  let _ = mp_put st mp_f_en j i (amb_p / gamma_m1 + me)
  mp_put st mp_f_bt j i btg

mv_ghost_loop st btp m i =
  if i >= mp_nrnz then 0
  else
    let _ = mv_ghost_cell st btp m (i / mp_nz) (i % mp_nz)
    mv_ghost_loop st btp m (i + 1)

mv_apply_ghosts st btp m = mv_ghost_loop st btp m 0

-- ── interior update: conservative in r (2026-08-31 night rewrite) ──
-- The old unweighted quarter-average + geometric sources CREATED mass at
-- O(dr/r) per cell (~7e-3 kg/s on seg 4 - more than the inlet flow;
-- caught by phase2_massaudit's flux-vs-inventory comparison).
-- Fields 0..3 now update in face-flux form on the conserved r U:
--     Phi_rface = r_f [ 0.5 (F_c + F_nb) - (dr/4dt) (U_nb - U_c) ]
--     dU = -(dt / (r_j dr)) (Phi_r+ - Phi_r-) - (dt/dz)(Phihat_z+ - Phihat_z-)
-- so sum(r_j U_j) telescopes to the boundary EXACTLY. Properties:
--   r_f- = 0 at j = 1 kills the axis face automatically (zero area);
--   r_f+ + r_f- = 2 r_j keeps the self-weight identical to the flat
--   quarter-average at every j (no stability change);
--   diffusion acts on U scaled by area, so uniform states are preserved
--   and every mirror-ghost cancellation (walls, electrodes, metered
--   inlet) carries over unchanged.
-- Geometric sources REDUCE to the exact conservative-form residue:
--   mass, m_z, E: none;  m_r: + (p - B^2/2mu0) / r  (theta-theta stress).
-- bt stays on the flat form: azimuthal induction is a flat 2D
-- conservation law (dB/dt + d_r(vr B) + d_z(vz B) = 0) - do NOT weight.
mv_lxf_field st ns cr cz fb j i f =
  let srp = float_arr_get fb f
  let srm = float_arr_get fb (5 + f)
  let szp = float_arr_get fb (10 + f)
  let szm = float_arr_get fb (15 + f)
  let drp = float_arr_get fb (20 + f)
  let drm = float_arr_get fb (25 + f)
  let dzp = float_arr_get fb (30 + f)
  let dzm = float_arr_get fb (35 + f)
  let uc = mp_get st f j i
  if f == 4 then
    let fa = uc + (drp - drm + dzp - dzm) / 4.0
    float_arr_set ns (mp_idx f j i) (fa - cr * (srp - srm) - cz * (szp - szm))
  else
    let r = mp_r_of j
    let rfp = r + 0.5 * mp_dr
    let rfm = r - 0.5 * mp_dr
    let rdif = (rfp * drp - rfm * drm) / (4.0 * r)
    let radv = cr * (rfp * srp - rfm * srm) / r
    let zdif = (dzp - dzm) / 4.0
    let zadv = cz * (szp - szm)
    float_arr_set ns (mp_idx f j i) (uc + rdif - radv + zdif - zadv)

mv_lxf_apply st ns cr cz fb ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let _ = mv_lxf_field st ns cr cz fb j i 0
  let _ = mv_lxf_field st ns cr cz fb j i 1
  let _ = mv_lxf_field st ns cr cz fb j i 2
  let _ = mv_lxf_field st ns cr cz fb j i 3
  mv_lxf_field st ns cr cz fb j i 4

-- theta-theta stress residue of the conservative r-form: m_r only
mv_geom_src st ns scr dt j i =
  let r = mp_r_of j
  let bt = mp_get st mp_f_bt j i
  let p = float_arr_get scr (scr_parr + j * mp_nz + i)
  let src = (p - 0.5 * bt * bt * inv_mu0) / r
  mp_put ns mp_f_mr j i (mp_get ns mp_f_mr j i + dt * src)

mv_cell st ns m cr cz fb scr ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let _ = mv_face_r st scr m fb j i 0 20
  let _ = mv_face_r st scr m fb (j - 1) i 5 25
  let _ = mv_face_z st scr m fb j i 10 30
  let _ = mv_face_z st scr m fb j (i - 1) 15 35
  mv_lxf_apply st ns cr cz fb ji

mv_lxf_loop st ns m cr cz fb scr ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_cell st ns m cr cz fb scr ji else 0
    mv_lxf_loop st ns m cr cz fb scr (ji + 1)

mv_geom_loop st ns m scr dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_geom_src st ns scr dt (ji / mp_nz) (ji % mp_nz) else 0
    mv_geom_loop st ns m scr dt (ji + 1)

-- ── non-ideal induction ──
mv_jr st j i = 0.0 - inv_mu0 * (mp_get st mp_f_bt j (i + 1) - mp_get st mp_f_bt j (i - 1)) / (2.0 * mp_dz)

mv_jz st j i =
  let r = mp_r_of j
  let rp = r + mp_dr
  let rm = r - mp_dr
  let rs = if r < 0.0001 then 0.0001 else r
  inv_mu0 * (rp * mp_get st mp_f_bt (j + 1) i - rm * mp_get st mp_f_bt (j - 1) i) / (2.0 * mp_dr * rs)

-- Spitzer needs the actual temperature: under the Saha EOS the old ideal
-- readback p m/(rho k) equals (1+alpha) T, up to 2x hot in ionized gas,
-- so eta comes from the same e_int -> T inversion the pressure uses.
-- COST: the inversion bisects (24 exp evals in hot cells). The step used
-- to call this ~6x/cell (sweeps + heat) and mv_pressure ~6x/cell more,
-- which made the first Saha binary ~7x slower than ideal. But e_int is
-- INVARIANT under field transport (the me-pairing telescopes exactly),
-- so eta at step start is exact for the whole sweep+heat phase, and p
-- after ghosts is exact for the whole hyperbolic phase: mv_step now
-- fills per-cell caches (scr_eta, scr_parr) once each and everything
-- else reads them. 2 inversions/cell/step instead of ~12.
-- PARTIALLY-IONIZED resistivity (greenlit 2026-09-01): electron-ion
-- (Spitzer) + electron-neutral, in series on the same electrons so the
-- resistivities ADD. Uses the Saha alpha the EOS already provides.
--   eta_en = m_e nu_en / (n_e e^2),  nu_en = n_n sigma_en v_te,
--   v_te = sqrt(8 k T / pi m_e),  sigma_en = 1e-19 m^2 (argon,
--   Ramsauer-averaged first cut)
--   => eta_en = 2.2046e-8 sqrt(T) (1 - alpha) / alpha   [Ohm m]
-- Cold neutral argon is nearly an insulator (alpha floored at 1e-8 ->
-- the cap catches it): current flows only where gas is ionized, so arc
-- constriction - the attachment mechanism itself - emerges instead of
-- being erased by a uniform capped eta. eta_en == Spitzer near
-- alpha ~ 5-10% at 1 eV; above that Spitzer dominates as before.
mv_eta_calc st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let ei = 1.0 * mv_eint st j i
  let n = rho_safe / m_ion_ar
  let t = 1.0 * eos_temp n ei
  let a_raw = 1.0 * eos_alpha n t
  let a = if a_raw < 0.00000001 then 0.00000001 else a_raw
  let t_eV = t / 11604.518
  let t_c = if t_eV < 0.1 then 0.1 else t_eV
  -- Coulomb logarithm (greenlit 2026-09-01 late): the old coefficient
  -- 5.0e-5 was Spitzer 5.2e-5 ln(Lambda) with ln(Lambda) = 0.96, i.e.
  -- the arc 4-5x too conductive in its current-carrying cells (NRL
  -- gives 5-6 there). NRL form for T_e < 10 eV, n_e in cm^-3:
  --   ln(Lambda) = 23 - ln(sqrt(n_e) / T_eV^1.5), clipped to [2, 20]
  -- n_e = alpha n from the same Saha inversion; the alpha floor makes
  -- n_e tiny in cold gas, where the clip at 20 bounds it and eta_en
  -- dominates anyway.
  let ne_cm3 = a * n * 0.000001
  let ne_c = if ne_cm3 < 1.0 then 1.0 else ne_cm3
  let lnl_raw = 23.0 - 0.5 * log ne_c + 1.5 * log t_c
  let lnl = if lnl_raw < 2.0 then 2.0 else if lnl_raw > 20.0 then 20.0 else lnl_raw
  let e_ei = 5.2e-5 * lnl / (t_c * sqrt t_c)
  let e_en = 2.2046e-8 * sqrt t * (1.0 - a) / a
  let eta = e_ei + e_en
  if eta > eta_cap then eta_cap else if eta < eta_floor then eta_floor else eta

mv_eta_cache scr j i = float_arr_get scr (scr_eta + j * mp_nz + i)

mv_eta_loop st scr ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set scr (scr_eta + ji) (mv_eta_calc st (ji / mp_nz) (ji % mp_nz))
    mv_eta_loop st scr (ji + 1)

-- build Er, Ez (into scr), pe = p/2 from the parr slice of scr
mv_efield_cell st scr j i =
  let k = j * mp_nz + i
  let jr = mv_jr st j i
  let jz = mv_jz st j i
  let bt = mp_get st mp_f_bt j i
  let rho = mp_get st mp_f_rho j i
  let ne_raw = rho / m_ion_ar
  let ne = if ne_raw < n_hall_floor then n_hall_floor else ne_raw
  let rh = 0.0 + run_hall
  let hc = rh * bt / (ne * e_charge)
  let pep = float_arr_get scr (scr_parr + j * mp_nz + i + 1)
  let pem = float_arr_get scr (scr_parr + j * mp_nz + i - 1)
  let dpe_dz = 0.5 * (pep - pem) / (2.0 * mp_dz)
  let pjp = float_arr_get scr (scr_parr + (j + 1) * mp_nz + i)
  let pjm = float_arr_get scr (scr_parr + (j - 1) * mp_nz + i)
  let dpe_dr = 0.5 * (pjp - pjm) / (2.0 * mp_dr)
  let inv_nee = rh / (ne * e_charge)
  let _ = float_arr_set scr k (0.0 - jz * hc - dpe_dr * inv_nee)
  float_arr_set scr (scr_ez + k) (jr * hc - dpe_dz * inv_nee)

mv_parr_loop st scr ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set scr (scr_parr + ji) (mv_pressure st (ji / mp_nz) (ji % mp_nz))
    mv_parr_loop st scr (ji + 1)

mv_efield_loop st scr unused ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let ok1 = if j >= 1 then j <= mp_nrm2 else false
    let ok = if ok1 then (if i >= 1 then i <= mp_nzm2 else false) else false
    let _ = if ok then mv_efield_cell st scr j i else 0
    mv_efield_loop st scr unused (ji + 1)

mv_induct_cell ns scr dt j i =
  let dez_dr = (float_arr_get scr (scr_ez + (j + 1) * mp_nz + i) - float_arr_get scr (scr_ez + (j - 1) * mp_nz + i)) / (2.0 * mp_dr)
  let der_dz = (float_arr_get scr (j * mp_nz + i + 1) - float_arr_get scr (j * mp_nz + i - 1)) / (2.0 * mp_dz)
  mp_put ns mp_f_bt j i (mp_get ns mp_f_bt j i + dt * (dez_dr - der_dz))

-- induction stencil needs E at j+-1, i+-1 which needs the E stencil
-- valid there: interior band j in [2, mp_nrm2-1], i in [2, mp_nzm2-1]
mv_induct_loop ns m scr dt ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let ok1 = if j >= 2 then j <= 127 else false
    let ok2 = if i >= 2 then i <= 103 else false
    let ok3 = if ok1 then ok2 else false
    let ok = if ok3 then arr_get m ji == 0 else false
    let _ = if ok then mv_induct_cell ns scr dt j i else 0
    mv_induct_loop ns m scr dt (ji + 1)

-- ── dt ──
mv_vmax_loop st m ji acc =
  if ji >= mp_nrnz then 1.0 * float_arr_get acc 0
  else
    let _ = if arr_get m ji == 0 then
        -- 1.0 * forces float typing of the user-fn result (marker quirk);
        -- without it the max-comparison runs on mistyped values
        let v = 1.0 * mv_speed st (ji / mp_nz) (ji % mp_nz)
        let cur = float_arr_get acc 0
        if v > cur then float_arr_set acc 0 v else 0
      else 0
    mv_vmax_loop st m (ji + 1) acc

mv_dt st m =
  let acc = float_arr_new 1 1.0
  let vmax = 1.0 * mv_vmax_loop st m 0 acc
  -- no resistive limit: diffusion is implicit (unconditionally stable)
  let d1 = cfl_c * mp_dr / vmax
  let rh = 0.0 + run_hall
  if rh > 0.5 then
    -- whistler limit at the Hall density floor and current max B scale
    let bmax = mv_bmax st m
    let bs = if bmax < 0.001 then 0.001 else bmax
    let dh = 0.1 * mp_dr * mp_dr * mu0 * n_hall_floor * e_charge / bs
    if dh < d1 then dh else d1
  else d1

mv_bmax_loop st m ji acc =
  if ji >= mp_nrnz then float_arr_get acc 0
  else
    let _ = if arr_get m ji == 0 then
        let b = mp_get st mp_f_bt (ji / mp_nz) (ji % mp_nz)
        let ab = if b < 0.0 then 0.0 - b else b
        let cur = float_arr_get acc 0
        if ab > cur then float_arr_set acc 0 ab else 0
      else 0
    mv_bmax_loop st m (ji + 1) acc

mv_bmax st m =
  let acc = float_arr_new 1 0.0
  let _ = mv_bmax_loop st m 0 acc
  float_arr_get acc 0

-- ── resistive diffusion: operator-split IMPLICIT (Thomas per line) ──
--   dB/dt = d/dz(D dB/dz) + d/dr(D (1/r) d(rB)/dr),  D = eta/mu0.
-- One backward-Euler tridiagonal solve per fluid segment of each z-line,
-- then each r-line (Lie splitting, first order like the rest). Dirichlet
-- faces (btp of the non-fluid neighbor; masks 3/7 carry 0 there) enter as
-- ghost = 2*face - cell folded into the diagonal and RHS. Workspace lives
-- in scr at scr_tri_* (four 130-slot lanes: sub, diag, super, rhs).

scr_tri_a = 41341
scr_tri_b = 41471
scr_tri_c = 41601
scr_tri_d = 41731

-- z-line coefficients for the fluid segment (j, i0 .. i0+n-1)
mv_zco ns scr dt j i0 n p =
  if p >= n then 0
  else
    let i = i0 + p
    let ec = 1.0 * mv_eta_cache scr j i
    let em = if p == 0 then ec else
        let e2 = 1.0 * mv_eta_cache scr j (i - 1)
        0.5 * (ec + e2)
    let ep = if p == n - 1 then ec else
        let e3 = 1.0 * mv_eta_cache scr j (i + 1)
        0.5 * (ec + e3)
    let dm = em * inv_mu0
    let dp = ep * inv_mu0
    let lam = dt / (mp_dz * mp_dz)
    let _ = float_arr_set scr (scr_tri_a + p) (0.0 - lam * dm)
    let _ = float_arr_set scr (scr_tri_c + p) (0.0 - lam * dp)
    let _ = float_arr_set scr (scr_tri_b + p) (1.0 + lam * (dm + dp))
    let _ = float_arr_set scr (scr_tri_d + p) (mp_get ns mp_f_bt j i)
    mv_zco ns scr dt j i0 n (p + 1)

-- r-line coefficients for the fluid segment (j0 .. j0+n-1, i).
-- A segment starting at j0 == 1 abuts the axis: the inner-face flux uses
-- g = 2B/r (exact for B ~ r, which is the physical axis behavior), no
-- Dirichlet fold there. rfm = 0 at j = 1 makes the generic form singular,
-- hence the branch.
mv_rco ns scr dt i j0 n p =
  if p >= n then 0
  else
    let j = j0 + p
    let r = mp_r_of j
    let ec = 1.0 * mv_eta_cache scr j i
    let em = if p == 0 then ec else
        let e2 = 1.0 * mv_eta_cache scr (j - 1) i
        0.5 * (ec + e2)
    let ep = if p == n - 1 then ec else
        let e3 = 1.0 * mv_eta_cache scr (j + 1) i
        0.5 * (ec + e3)
    let dm = em * inv_mu0
    let dp = ep * inv_mu0
    let lam = dt / (mp_dr * mp_dr)
    let rfp = r + 0.5 * mp_dr
    let rp = r + mp_dr
    let _ = float_arr_set scr (scr_tri_c + p) (0.0 - lam * dp * rp / rfp)
    let ax = if p == 0 then j == 1 else false
    let _ = if ax then
        let _ = float_arr_set scr (scr_tri_a + p) 0.0
        float_arr_set scr (scr_tri_b + p) (1.0 + lam * r * dp / rfp + dt * 2.0 * dm / (mp_dr * r))
      else
        let rfm = r - 0.5 * mp_dr
        let rm = r - mp_dr
        let _ = float_arr_set scr (scr_tri_a + p) (0.0 - lam * dm * rm / rfm)
        float_arr_set scr (scr_tri_b + p) (1.0 + lam * r * (dp / rfp + dm / rfm))
    let _ = float_arr_set scr (scr_tri_d + p) (mp_get ns mp_f_bt j i)
    mv_rco ns scr dt i j0 n (p + 1)

-- Dirichlet fold-in at the segment ends (ghost = 2*face - cell)
mv_tri_dir_l scr bf =
  let a0 = float_arr_get scr scr_tri_a
  let _ = float_arr_set scr scr_tri_b (float_arr_get scr scr_tri_b - a0)
  let _ = float_arr_set scr scr_tri_d (float_arr_get scr scr_tri_d - 2.0 * a0 * bf)
  float_arr_set scr scr_tri_a 0.0

mv_tri_dir_r scr n bf =
  let cn = float_arr_get scr (scr_tri_c + n - 1)
  let _ = float_arr_set scr (scr_tri_b + n - 1) (float_arr_get scr (scr_tri_b + n - 1) - cn)
  let _ = float_arr_set scr (scr_tri_d + n - 1) (float_arr_get scr (scr_tri_d + n - 1) - 2.0 * cn * bf)
  float_arr_set scr (scr_tri_c + n - 1) 0.0

mv_thomas_fwd scr n p =
  if p >= n then 0
  else
    let w = float_arr_get scr (scr_tri_a + p) / float_arr_get scr (scr_tri_b + p - 1)
    let _ = float_arr_set scr (scr_tri_b + p) (float_arr_get scr (scr_tri_b + p) - w * float_arr_get scr (scr_tri_c + p - 1))
    let _ = float_arr_set scr (scr_tri_d + p) (float_arr_get scr (scr_tri_d + p) - w * float_arr_get scr (scr_tri_d + p - 1))
    mv_thomas_fwd scr n (p + 1)

-- write one solved value with the magnetic-energy pairing (per-sweep
-- pairings telescope to the exact me change; p untouched by transport)
mv_diff_write ns j i x =
  let bold = mp_get ns mp_f_bt j i
  let db = x - bold
  let dme = (bold * db + 0.5 * db * db) * inv_mu0
  let _ = mp_put ns mp_f_en j i (mp_get ns mp_f_en j i + dme)
  mp_put ns mp_f_bt j i x

mv_zback ns scr j i0 p xn =
  if p < 0 then 0
  else
    let x = (float_arr_get scr (scr_tri_d + p) - float_arr_get scr (scr_tri_c + p) * xn) / float_arr_get scr (scr_tri_b + p)
    let _ = mv_diff_write ns j (i0 + p) x
    mv_zback ns scr j i0 (p - 1) x

mv_rback ns scr i j0 p xn =
  if p < 0 then 0
  else
    let x = (float_arr_get scr (scr_tri_d + p) - float_arr_get scr (scr_tri_c + p) * xn) / float_arr_get scr (scr_tri_b + p)
    let _ = mv_diff_write ns (j0 + p) i x
    mv_rback ns scr i j0 (p - 1) x

-- last fluid index of the run starting at a known-fluid cell
mv_zrun m j i =
  if i >= mp_nzm2 then mp_nzm2
  else if arr_get m (j * mp_nz + i + 1) == 0 then mv_zrun m j (i + 1)
  else i

mv_rrun m i j =
  if j >= mp_nrm2 then mp_nrm2
  else if arr_get m ((j + 1) * mp_nz + i) == 0 then mv_rrun m i (j + 1)
  else j

mv_zscan ns btp m scr dt j i =
  if i > mp_nzm2 then 0
  else if arr_get m (j * mp_nz + i) == 0 then
    let i1 = mv_zrun m j i
    let n = i1 - i + 1
    let _ = mv_zco ns scr dt j i n 0
    let _ = mv_tri_dir_l scr (float_arr_get btp (j * mp_nz + i - 1))
    let _ = mv_tri_dir_r scr n (float_arr_get btp (j * mp_nz + i1 + 1))
    let _ = mv_thomas_fwd scr n 1
    let _ = mv_zback ns scr j i (n - 1) 0.0
    mv_zscan ns btp m scr dt j (i1 + 2)
  else mv_zscan ns btp m scr dt j (i + 1)

mv_rscan ns btp m scr dt i j =
  if j > mp_nrm2 then 0
  else if arr_get m (j * mp_nz + i) == 0 then
    let j1 = mv_rrun m i j
    let n = j1 - j + 1
    let _ = mv_rco ns scr dt i j n 0
    let _ = if j == 1 then 0.0 else mv_tri_dir_l scr (float_arr_get btp ((j - 1) * mp_nz + i))
    let _ = mv_tri_dir_r scr n (float_arr_get btp ((j1 + 1) * mp_nz + i))
    let _ = mv_thomas_fwd scr n 1
    let _ = mv_rback ns scr i j (n - 1) 0.0
    mv_rscan ns btp m scr dt i (j1 + 2)
  else mv_rscan ns btp m scr dt i (j + 1)

mv_zsweep ns btp m scr dt j =
  if j > mp_nrm2 then 0
  else
    let _ = mv_zscan ns btp m scr dt j 1
    mv_zsweep ns btp m scr dt (j + 1)

mv_rsweep ns btp m scr dt i =
  if i > mp_nzm2 then 0
  else
    let _ = mv_rscan ns btp m scr dt i 1
    mv_rsweep ns btp m scr dt (i + 1)

-- explicit Ohmic heating dt eta j^2 (post-diffusion field; stencils at
-- boundary-adjacent cells read the previous fill of the ghost cells,
-- one operator stale, first-order like every source here)
-- Ohmic counter (2026-09-01, ships BEFORE the ln(Lambda) change): fb slot
-- 41 accumulates the Joules deposited, sum dt eta j^2 2 pi r dr dz over
-- fluid cells, so every step print can report V_arc = P_ohm / J.
mv_heat_cell ns scr fb dt j i =
  let et = 1.0 * mv_eta_cache scr j i
  let jr = 1.0 * mv_jr ns j i
  let jz = 1.0 * mv_jz ns j i
  let de = dt * et * (jr * jr + jz * jz)
  let r = mp_r_of j
  let vol = 6.283185307179586 * r * mp_dr * mp_dz
  let _ = float_arr_set fb 41 (float_arr_get fb 41 + de * vol)
  mp_put ns mp_f_en j i (mp_get ns mp_f_en j i + de)

mv_heat_loop ns m scr fb dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_heat_cell ns scr fb dt (ji / mp_nz) (ji % mp_nz) else 0.0
    mv_heat_loop ns m scr fb dt (ji + 1)

-- wall sink: cold-wall conduction for every fluid face whose neighbor
-- is electrode or wall (masks 1/2/4/5; never inlet 6, outflow 7, axis 3).
-- dE (energy DENSITY removed) = kappa_wall (T - t_wall) dt G, where G
-- sums A_face / (V_cell dx/2): r-face 2 r_f / (r dr^2), z-face 2/dz^2.
mv_wall_cell st m fb dt j i =
  let kbase = j * mp_nz + i
  let mrp = arr_get m (kbase + mp_nz)
  let mrm = arr_get m (kbase - mp_nz)
  let mzp = arr_get m (kbase + 1)
  let mzm = arr_get m (kbase - 1)
  let wrp = if mrp == 1 then 1 else if mrp == 2 then 1 else if mrp == 4 then 1 else if mrp == 5 then 1 else 0
  let wrm = if mrm == 1 then 1 else if mrm == 2 then 1 else if mrm == 4 then 1 else if mrm == 5 then 1 else 0
  let wzp = if mzp == 1 then 1 else if mzp == 2 then 1 else if mzp == 4 then 1 else if mzp == 5 then 1 else 0
  let wzm = if mzm == 1 then 1 else if mzm == 2 then 1 else if mzm == 4 then 1 else if mzm == 5 then 1 else 0
  if wrp + wrm + wzp + wzm == 0 then 0.0
  else
    let ei = 1.0 * mv_eint st j i
    if ei < 0.000000001 then 0.0
    else
      let rho = mp_get st mp_f_rho j i
      let rho_safe = if rho < rho_floor then rho_floor else rho
      let n = rho_safe / m_ion_ar
      let t = 1.0 * eos_temp n ei
      if t <= t_wall then 0.0
      else
        let r = 1.0 * mp_r_of j
        let gr = 2.0 / (r * mp_dr * mp_dr)
        let gz = 2.0 / (mp_dz * mp_dz)
        let g1 = to_float wrp * gr * (r + 0.5 * mp_dr)
        let g2 = to_float wrm * gr * (r - 0.5 * mp_dr)
        let g3 = to_float (wzp + wzm) * gz
        let g = g1 + g2 + g3
        let de_raw = kappa_wall * (t - t_wall) * dt * g
        let de = if de_raw > 0.5 * ei then 0.5 * ei else de_raw
        let _ = mp_put st mp_f_en j i (mp_get st mp_f_en j i - de)
        let vol = mv_tau * r * mp_dr * mp_dz
        float_arr_set fb 40 (float_arr_get fb 40 + de * vol)

mv_wall_loop st m fb dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_wall_cell st m fb dt (ji / mp_nz) (ji % mp_nz) else 0.0
    mv_wall_loop st m fb dt (ji + 1)

-- vacuum guard: state density floor + velocity cap (rescale momenta).
-- The pinch evacuates the near-cathode region; without this the Alfven
-- speed there collapses dt. facc[0] accumulates the mass ADDED by the
-- floor (kg) so the budget is reported, not silent.
rho_min_state = 0.000001
v_cap = 100000.0

scr_fmass = 41340

mv_floor_cell ns facc j i =
  let rho = mp_get ns mp_f_rho j i
  let _ = if rho < rho_min_state then
      let dv = 6.283185307179586 * mp_r_of j * mp_dr * mp_dz
      let _ = float_arr_set facc scr_fmass (float_arr_get facc scr_fmass + (rho_min_state - rho) * dv)
      mp_put ns mp_f_rho j i rho_min_state
    else 0.0
  let rho2 = mp_get ns mp_f_rho j i
  let mr = mp_get ns mp_f_mr j i
  let mz = mp_get ns mp_f_mz j i
  let v = sqrt ((mr * mr + mz * mz) / (rho2 * rho2))
  if v > v_cap then
    let sc = v_cap / v
    let _ = mp_put ns mp_f_mr j i (mr * sc)
    mp_put ns mp_f_mz j i (mz * sc)
  else 0.0

mv_floor_loop ns m facc ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_floor_cell ns facc (ji / mp_nz) (ji % mp_nz) else 0
    mv_floor_loop ns m facc (ji + 1)

-- checkpoint: full state as one f32 payload (f32 truncation ~1e-7 rel,
-- fine for resume; NOT for attestation)
mv_save_state path st = float_arr_to_f32_file path st mp_state
mv_load_state path st = float_arr_from_f32_file path st mp_state

-- ── mass bookkeeping (the conservation gate's currency) ──
mv_tau = 6.283185307179586

mv_mass_loop st m ji acc =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then
        let rho = float_arr_get st ji
        float_arr_set acc 0 (float_arr_get acc 0 + rho * mv_tau * mp_r_of (ji / mp_nz) * mp_dr * mp_dz)
      else 0
    mv_mass_loop st m (ji + 1) acc

mv_total_mass st m =
  let acc = float_arr_new 1 0.0
  let _ = mv_mass_loop st m 0 acc
  float_arr_get acc 0

-- Boundary mass rate (kg/s INTO the domain), using the scheme's exact
-- face fluxes: r-faces carry area 2 pi r_f dz (r_f = 0 kills the axis
-- face), z-faces 2 pi r_j dr. Ghosts must be applied first. With the
-- conservative interior, d(total mass)/dt == this + floor additions,
-- to rounding - selftest check 26 holds that equality per step.
mv_bmass_face st m acc dt j i dj di =
  let mk = arr_get m ((j + dj) * mp_nz + i + di)
  if mk == 0 then 0.0
  else if mk == 6 then
    -- prescribed inlet face (mv_face_zin): the scheme delivers exactly
    -- rho_in v_in through it, no ghost term and no diffusive term
    let rho_in = if j <= mp_j_in1b then in_rho_ann else in_rho_ring
    let r = mp_r_of j
    let rate = rho_in * in_v * mv_tau * r * mp_dr
    float_arr_set acc 0 (float_arr_get acc 0 + rate)
  else
    let r = mp_r_of j
    let rc = mp_get st mp_f_rho j i
    let rg = mp_get st mp_f_rho (j + dj) (i + di)
    let rate = if dj == 0 then
        let fc = mp_get st mp_f_mz j i
        let fg = mp_get st mp_f_mz (j + dj) (i + di)
        let fh = 0.5 * (fc + fg) - (mp_dz / (4.0 * dt)) * to_float di * (rg - rc)
        (0.0 - to_float di) * fh * mv_tau * r * mp_dr
      else
        let rf = r + to_float dj * 0.5 * mp_dr
        let fc = mp_get st mp_f_mr j i
        let fg = mp_get st mp_f_mr (j + dj) (i + di)
        let fh = 0.5 * (fc + fg) - (mp_dr / (4.0 * dt)) * to_float dj * (rg - rc)
        (0.0 - to_float dj) * fh * mv_tau * rf * mp_dz
    float_arr_set acc 0 (float_arr_get acc 0 + rate)

mv_bmass_loop st m acc dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then
        let j = ji / mp_nz
        let i = ji % mp_nz
        let _ = mv_bmass_face st m acc dt j i 1 0
        let _ = mv_bmass_face st m acc dt j i (0 - 1) 0
        let _ = mv_bmass_face st m acc dt j i 0 1
        mv_bmass_face st m acc dt j i 0 (0 - 1)
      else 0.0
    mv_bmass_loop st m acc dt (ji + 1)

mv_bmass_rate st m dt =
  let acc = float_arr_new 1 0.0
  let _ = mv_bmass_loop st m acc dt 0
  float_arr_get acc 0

-- MEASURED inlet mass rate (kg/s INTO the domain) through the mask-6
-- faces. Reuses mv_bmass_face verbatim for the z-face with di = -1, so
-- it is the scheme's own flux by construction, not a second opinion.
-- Ghosts must be applied first.
-- Ships as a counter BEFORE the cap fix (2026-09-01): the runner prints
-- this every period, so an inlet that stops metering can never again be
-- read as nominal off a hardcoded "(in 0.006)".
mv_inlet_loop st m acc dt j =
  if j >= mp_nr then 0.0
  else
    let _ = if arr_get m (j * mp_nz) == 6 then
        mv_bmass_face st m acc dt j 1 0 (0 - 1)
      else 0.0
    mv_inlet_loop st m acc dt (j + 1)

mv_inlet_rate st m dt =
  let acc = float_arr_new 1 0.0
  let _ = mv_inlet_loop st m acc dt 0
  float_arr_get acc 0

-- ── one full step ──
-- Order (Lie splitting): eta cache from step-start e_int (exact through
-- the sweeps: field transport preserves e_int), implicit resistive
-- sweeps + Ohmic heat in-place on st, then ghosts, then the p cache
-- (exact for the whole hyperbolic phase), hyperbolic st -> ns
-- (+ explicit Hall), floor. ns and scratch are caller-owned and reused
-- (no per-step allocation; the caller double-buffers st <-> ns).
-- fb: 42-float flux scratch (see mv_lxf_field layout). scr: one 55641-float array carved by offset
-- (er 0, ez +13780, parr +27560, fmass 41340, tridiagonal lanes
-- 41341..41860, eta +41861).
mv_step st ns btp m fb scr dt =
  let _ = mv_eta_loop st scr 0
  let _ = mv_zsweep st btp m scr dt 1
  let _ = mv_rsweep st btp m scr dt 1
  let _ = mv_heat_loop st m scr fb dt 0
  let _ = mv_wall_loop st m fb dt 0
  let _ = mv_apply_ghosts st btp m
  let _ = mv_parr_loop st scr 0
  let cr = dt / (2.0 * mp_dr)
  let cz = dt / (2.0 * mp_dz)
  let _ = mv_lxf_loop st ns m cr cz fb scr 0
  let _ = mv_geom_loop st ns m scr dt 0
  let rh = 0.0 + run_hall
  let _ = if rh > 0.5 then
      let _ = mv_efield_loop st scr 0 0
      mv_induct_loop ns m scr dt 0
    else 0
  mv_floor_loop ns m scr 0

scr_ez = 13780
scr_parr = 27560
scr_eta = 41861

-- ── init ──
-- GAS PREFILL at 300 K (2026-08-31 night): a cold start from amb_rho
-- (3e-5) with the full 8 kA field is a death spiral - the field pumps
-- the chamber out faster than the choked inlet can feed it, rho falls,
-- v_A rises, dt collapses (out/phase2_cold1.log: mass 8x down, vmax
-- 110k, dt 1.4e-9 after 60k steps). Real devices flow gas BEFORE the
-- arc. fill_rho ~ the expected steady mean (mass ~4e-6 kg over ~1.3e-3
-- m^3); the steady state does not depend on the init, and the prefill
-- also lowers init v_A ~15x, so dt0 is ~7x bigger.
fill_rho = 0.002

mv_init_cell st jtot ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let r = mp_r_of j
  let ra = if r < 0.0005 then 0.0005 else r
  let g = 1.0 - mp_z_of i / 0.13
  -- enclosed-current-consistent ramp: I -> 0 at the axis, ~J outside r_c
  let ifrac = ra * ra / (ra * ra + pbt_r_c * pbt_r_c)
  let bt = mu0_2pi * jtot * g * ifrac / ra
  let me = 0.5 * bt * bt * inv_mu0
  let _ = mp_put st mp_f_rho j i fill_rho
  let _ = mp_put st mp_f_mr j i 0.0
  let _ = mp_put st mp_f_mz j i 0.0
  let _ = mp_put st mp_f_en j i (fill_rho * kT_m / gamma_m1 + me)
  mp_put st mp_f_bt j i bt

mv_init_loop st jtot ji =
  if ji >= mp_nrnz then 0
  else
    let _ = mv_init_cell st jtot ji
    mv_init_loop st jtot (ji + 1)

mv_init jtot =
  let st = float_arr_new mp_state 0.0
  let _ = mv_init_loop st jtot 0
  st

-- copy the bt block into a standalone array for stress_diag
mv_bt_slice st bt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set bt ji (float_arr_get st (4 * mp_nrnz + ji))
    mv_bt_slice st bt (ji + 1)

mv_extract_bt st =
  let bt = float_arr_new mp_nrnz 0.0
  let _ = mv_bt_slice st bt 0
  bt
