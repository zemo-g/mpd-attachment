-- rail/mpd_solver.rail -- Phase 2 solver: axisymmetric resistive MHD with
-- Hall term, azimuthal-only self-field B_theta, attachment PRESCRIBED as
-- B_theta Dirichlet faces (rail/mhd_pbt.rail).
--
-- Dependencies (import order in the runner, no dedupe):
--   rail/pbt.rail, rail/mhd_pbt.rail, rail/stress_diag.rail, this file.
-- The RUNNER must define: run_hall (1.0 on / 0.0 off).
--
-- Scheme notes (deliberate, see program.md phase 2):
--   Fluxes carry total pressure p_t = p + B^2/2mu0; the ONLY momentum
--   sources are the axisym geometric ones:
--     d(rho)/dt += -rho v_r / r
--     d(m_r)/dt += -m_r v_r / r - B^2/(mu0 r)     (hoop tension)
--     d(m_z)/dt += -m_z v_r / r
--     d(E)/dt   += -(E + p_t) v_r / r
--   No explicit J x B source: with azimuthal-only B the Lorentz force IS
--   the Maxwell stress already present in flux + hoop. (The stdlib
--   mhd_mpd.rail pack double-counts this; deliberately not reused.)
--   B_theta axial flux is +v_z B_theta (divergence-form advection; the
--   stdlib core's -v_z B_theta is an in-plane-B holdover).
--   Non-ideal induction, resistive part: operator-split IMPLICIT
--   diffusion (Thomas tridiagonal per z-line then per r-line, done
--   in-place on st before the hyperbolic update). Unconditionally stable:
--   every explicit form detonates at dr=0.5mm because the resistive layer
--   sqrt(eta t / mu0) ~ 0.4mm is sub-cell against pinned Dirichlet faces
--   (three A/B-isolated attempts, 2026-08-31). Prescribed faces fold into
--   the tridiagonal (ghost = 2 face - cell absorbed into diag/rhs, so no
--   ghost feedback loop); the axis face uses the linear-B regularization
--   g = 2B/r (exact for B ~ r). Energy: en += (B dB + dB^2/2)/mu0 at each
--   sweep write (telescopes to the exact magnetic-energy change, so p is
--   untouched by field transport) plus explicit Ohmic heating dt eta j^2.
--   Hall + grad-pe stay explicit (whistler dt) and p-absorbing, as before.
--   eta = Spitzer 5e-5/T_eV^1.5 capped to [1e-7, 2e-5] (physical band);
--   Hall density floor n_hall = 1e19 m^-3 (standard vacuum clamp).

gamma_m1 = 0.6666666666666667
e_charge = 1.602176634e-19
m_ion_ar = 6.633e-26
cfl_c = 0.30
eta_cap = 2.0e-5
eta_floor = 1.0e-7
n_hall_floor = 1.0e19

-- inlet (argon 6 g/s, 54% annulus / 46% ring, 300 m/s, 300 K)
in_v = 300.0
-- ghost-velocity cap: 2000 m/s clears nominal metering by 6.7x at
-- operating density while staying 150x under the ~3e5 m/s that
-- detonated the uncapped ghost on near-vacuum fluid
in_vg_cap = 2000.0
in_rho_ann = 0.014707
in_rho_ring = 0.0064220
kT_m = 62444.0

rho_floor = 0.00000001
amb_rho = 0.00003
amb_p = 1.0

-- ── pressure/speed on state (rho floor + p floor) ──
mv_pressure st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let e = mp_get st mp_f_en j i
  let ke = 0.5 * (mr * mr + mz * mz) / rho_safe
  let me = 0.5 * bt * bt * inv_mu0
  let p_raw = gamma_m1 * (e - ke - me)
  if p_raw < 0.000001 then 0.000001 else p_raw

mv_speed st j i =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let p = mv_pressure st j i
  let a2 = 1.6666666666666667 * p / rho_safe
  let va2 = bt * bt * inv_mu0 / rho_safe
  let v2 = (mr * mr + mz * mz) / (rho_safe * rho_safe)
  sqrt v2 + sqrt (a2 + va2)

-- ── fluxes ──
-- fb is a single 20-float scratch: offsets 0 r-plus, 5 r-minus, 10 z-plus,
-- 15 z-minus (one allocation per run; keeps loop arity <= 8 for TCO)
mv_flux_r st j i fb off =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let e = mp_get st mp_f_en j i
  let vr = mr / rho_safe
  let p = mv_pressure st j i
  let pt = p + 0.5 * bt * bt * inv_mu0
  let _ = float_arr_set fb off mr
  let _ = float_arr_set fb (off + 1) (mr * vr + pt)
  let _ = float_arr_set fb (off + 2) (mz * vr)
  let _ = float_arr_set fb (off + 3) ((e + pt) * vr)
  float_arr_set fb (off + 4) (vr * bt)

mv_flux_z st j i fb off =
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let mr = mp_get st mp_f_mr j i
  let mz = mp_get st mp_f_mz j i
  let bt = mp_get st mp_f_bt j i
  let e = mp_get st mp_f_en j i
  let vz = mz / rho_safe
  let p = mv_pressure st j i
  let pt = p + 0.5 * bt * bt * inv_mu0
  let _ = float_arr_set fb off mz
  let _ = float_arr_set fb (off + 1) (mr * vz)
  let _ = float_arr_set fb (off + 2) (mz * vz + pt)
  let _ = float_arr_set fb (off + 3) ((e + pt) * vz)
  float_arr_set fb (off + 4) (vz * bt)

-- ── ghost fill for the full state ──
-- gas: mirror with normal momentum negated (free slip), en rebuilt so the
-- ghost holds the fluid's p with its own momenta and bt.
mv_ghost_gas st jg ig jf fi nsign_r nsign_z btg =
  let rho = mp_get st mp_f_rho jf fi
  let mr = mp_get st mp_f_mr jf fi * nsign_r
  let mz = mp_get st mp_f_mz jf fi * nsign_z
  let p = mv_pressure st jf fi
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let ke = 0.5 * (mr * mr + mz * mz) / rho_safe
  let me = 0.5 * btg * btg * inv_mu0
  let _ = mp_put st mp_f_rho jg ig rho
  let _ = mp_put st mp_f_mr jg ig mr
  let _ = mp_put st mp_f_mz jg ig mz
  let _ = mp_put st mp_f_en jg ig (p / gamma_m1 + ke + me)
  mp_put st mp_f_bt jg ig btg

mv_ghost_cell st btp m j i =
  let k = j * mp_nz + i
  let mk = arr_get m k
  if mk == 0 then 0
  else if mk == 3 then
    let btg = 0.0 - mp_get st mp_f_bt 1 i
    mv_ghost_gas st j i 1 i (0.0 - 1.0) 1.0 btg
  else if mk == 4 then
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_nrm2 i
    mv_ghost_gas st j i mp_nrm2 i (0.0 - 1.0) 1.0 btg
  else if mk == 5 then
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j 1
    mv_ghost_gas st j i j 1 1.0 (0.0 - 1.0) btg
  else if mk == 6 then
    -- inlet: FLUX-METERED gas ghost (mass audit 2026-08-31: the naive
    -- rho/v Dirichlet ghost admitted 1.34x nominal - the LxF face flux
    -- 0.5(F_c+F_g) - (dz/4dt)(rho_c-rho_g) adds the fluid-side momentum
    -- average AND a rho-diffusion influx). Ghost rho copies the fluid
    -- cell (kills the diffusive term); ghost mz reflects around the
    -- nominal so the face average is EXACTLY rho_in v_in; en carries a
    -- 300 K reservoir at the copied density.
    -- The reflected momentum is CAPPED at |vz_ghost| <= in_vg_cap: with
    -- near-vacuum fluid the uncapped ghost hits ~3e5 m/s (mz nominal
    -- over a tiny copied rho) and detonates the row on cold start - and
    -- mv_dt never sees ghost speeds. Physically a mass-flow controller
    -- cannot force 6 g/s into vacuum; the cap is the choked
    -- valve-opening transient, and it disengages in the operating
    -- regime (vz_ghost ~ in_v there), where metering is exact.
    let rho_in = if j <= mp_j_in1b then in_rho_ann else in_rho_ring
    let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j 1
    let rho_c = mp_get st mp_f_rho j 1
    let rho = if rho_c < rho_floor then rho_floor else rho_c
    let mzc = mp_get st mp_f_mz j 1
    let mzn = 2.0 * rho_in * in_v - mzc
    let cap = 1.0 * rho * in_vg_cap
    let mzg = if mzn > cap then cap else if mzn < 0.0 - cap then 0.0 - cap else mzn
    let ke = 0.5 * mzg * mzg / rho
    let me = 0.5 * btg * btg * inv_mu0
    let _ = mp_put st mp_f_rho j i rho
    let _ = mp_put st mp_f_mr j i 0.0
    let _ = mp_put st mp_f_mz j i mzg
    let _ = mp_put st mp_f_en j i (rho * kT_m / gamma_m1 + ke + me)
    mp_put st mp_f_bt j i btg
  else if mk == 7 then
    let btg = 0.0 - mp_get st mp_f_bt j mp_nzm2
    mv_ghost_gas st j i j mp_nzm2 1.0 1.0 btg
  else if mk == 1 then
    if i == mp_i_tip then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_tip1
      mv_ghost_gas st j i j mp_i_tip1 1.0 (0.0 - 1.0) btg
    else if j == mp_j_cath then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_j_fluid0 i
      mv_ghost_gas st j i mp_j_fluid0 i (0.0 - 1.0) 1.0 btg
    else mv_ghost_solid st btp j i
  else
    if j == mp_j_anode then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt mp_j_anodem1 i
      mv_ghost_gas st j i mp_j_anodem1 i (0.0 - 1.0) 1.0 btg
    else if i == mp_i_an0 then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_aif
      mv_ghost_gas st j i j mp_i_aif 1.0 (0.0 - 1.0) btg
    else if i == mp_i_an1 then
      let btg = 2.0 * float_arr_get btp k - mp_get st mp_f_bt j mp_i_aof
      mv_ghost_gas st j i j mp_i_aof 1.0 (0.0 - 1.0) btg
    else mv_ghost_solid st btp j i

mv_ghost_solid st btp j i =
  let btg = float_arr_get btp (j * mp_nz + i)
  let me = 0.5 * btg * btg * inv_mu0
  let _ = mp_put st mp_f_rho j i amb_rho
  let _ = mp_put st mp_f_mr j i 0.0
  let _ = mp_put st mp_f_mz j i 0.0
  let _ = mp_put st mp_f_en j i (amb_p / gamma_m1 + me)
  mp_put st mp_f_bt j i btg

mv_ghost_loop st btp m i =
  if i >= mp_nrnz then 0
  else
    let _ = mv_ghost_cell st btp m (i / mp_nz) (i % mp_nz)
    mv_ghost_loop st btp m (i + 1)

mv_apply_ghosts st btp m = mv_ghost_loop st btp m 0

-- ── interior update: conservative in r (2026-08-31 night rewrite) ──
-- The old unweighted quarter-average + geometric sources CREATED mass at
-- O(dr/r) per cell (~7e-3 kg/s on seg 4 - more than the inlet flow;
-- caught by phase2_massaudit's flux-vs-inventory comparison).
-- Fields 0..3 now update in face-flux form on the conserved r U:
--     Phi_rface = r_f [ 0.5 (F_c + F_nb) - (dr/4dt) (U_nb - U_c) ]
--     dU = -(dt / (r_j dr)) (Phi_r+ - Phi_r-) - (dt/dz)(Phihat_z+ - Phihat_z-)
-- so sum(r_j U_j) telescopes to the boundary EXACTLY. Properties:
--   r_f- = 0 at j = 1 kills the axis face automatically (zero area);
--   r_f+ + r_f- = 2 r_j keeps the self-weight identical to the flat
--   quarter-average at every j (no stability change);
--   diffusion acts on U scaled by area, so uniform states are preserved
--   and every mirror-ghost cancellation (walls, electrodes, metered
--   inlet) carries over unchanged.
-- Geometric sources REDUCE to the exact conservative-form residue:
--   mass, m_z, E: none;  m_r: + (p - B^2/2mu0) / r  (theta-theta stress).
-- bt stays on the flat form: azimuthal induction is a flat 2D
-- conservation law (dB/dt + d_r(vr B) + d_z(vz B) = 0) - do NOT weight.
mv_lxf_field st ns cr cz fb j i f =
  if f == 4 then
    let fa = (mp_get st f (j + 1) i + mp_get st f (j - 1) i + mp_get st f j (i + 1) + mp_get st f j (i - 1)) / 4.0
    let dfr = float_arr_get fb f - float_arr_get fb (5 + f)
    let dfz = float_arr_get fb (10 + f) - float_arr_get fb (15 + f)
    float_arr_set ns (mp_idx f j i) (fa - cr * dfr - cz * dfz)
  else
    let r = mp_r_of j
    let rfp = r + 0.5 * mp_dr
    let rfm = r - 0.5 * mp_dr
    let uc = mp_get st f j i
    let un = mp_get st f (j + 1) i
    let us = mp_get st f (j - 1) i
    let ue = mp_get st f j (i + 1)
    let uw = mp_get st f j (i - 1)
    let fcr = float_arr_get fb (20 + f)
    let fn = float_arr_get fb f
    let fs = float_arr_get fb (5 + f)
    let fe = float_arr_get fb (10 + f)
    let fw = float_arr_get fb (15 + f)
    let rdif = (rfp * (un - uc) + rfm * (us - uc)) / (4.0 * r)
    let radv = cr * (rfp * (fcr + fn) - rfm * (fs + fcr)) / r
    let zdif = (ue + uw - 2.0 * uc) / 4.0
    let zadv = cz * (fe - fw)
    float_arr_set ns (mp_idx f j i) (uc + rdif - radv + zdif - zadv)

mv_lxf_apply st ns cr cz fb ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let _ = mv_lxf_field st ns cr cz fb j i 0
  let _ = mv_lxf_field st ns cr cz fb j i 1
  let _ = mv_lxf_field st ns cr cz fb j i 2
  let _ = mv_lxf_field st ns cr cz fb j i 3
  mv_lxf_field st ns cr cz fb j i 4

-- theta-theta stress residue of the conservative r-form: m_r only
mv_geom_src st ns dt j i =
  let r = mp_r_of j
  let bt = mp_get st mp_f_bt j i
  let p = mv_pressure st j i
  let src = (p - 0.5 * bt * bt * inv_mu0) / r
  mp_put ns mp_f_mr j i (mp_get ns mp_f_mr j i + dt * src)

mv_cell st ns cr cz fb ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let _ = mv_flux_r st (j + 1) i fb 0
  let _ = mv_flux_r st (j - 1) i fb 5
  let _ = mv_flux_z st j (i + 1) fb 10
  let _ = mv_flux_z st j (i - 1) fb 15
  let _ = mv_flux_r st j i fb 20
  mv_lxf_apply st ns cr cz fb ji

mv_lxf_loop st ns m cr cz fb ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_cell st ns cr cz fb ji else 0
    mv_lxf_loop st ns m cr cz fb (ji + 1)

mv_geom_loop st ns m dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_geom_src st ns dt (ji / mp_nz) (ji % mp_nz) else 0
    mv_geom_loop st ns m dt (ji + 1)

-- ── non-ideal induction ──
mv_jr st j i = 0.0 - inv_mu0 * (mp_get st mp_f_bt j (i + 1) - mp_get st mp_f_bt j (i - 1)) / (2.0 * mp_dz)

mv_jz st j i =
  let r = mp_r_of j
  let rp = r + mp_dr
  let rm = r - mp_dr
  let rs = if r < 0.0001 then 0.0001 else r
  inv_mu0 * (rp * mp_get st mp_f_bt (j + 1) i - rm * mp_get st mp_f_bt (j - 1) i) / (2.0 * mp_dr * rs)

mv_eta st j i =
  let p = mv_pressure st j i
  let rho = mp_get st mp_f_rho j i
  let rho_safe = if rho < rho_floor then rho_floor else rho
  let t_eV = p * m_ion_ar * 6.244e18 / rho_safe
  let t_c = if t_eV < 0.1 then 0.1 else t_eV
  let eta = 5.0e-5 / (t_c * sqrt t_c)
  if eta > eta_cap then eta_cap else if eta < eta_floor then eta_floor else eta

-- build Er, Ez (into scr), pe = p/2 from the parr slice of scr
mv_efield_cell st scr j i =
  let k = j * mp_nz + i
  let jr = mv_jr st j i
  let jz = mv_jz st j i
  let bt = mp_get st mp_f_bt j i
  let rho = mp_get st mp_f_rho j i
  let ne_raw = rho / m_ion_ar
  let ne = if ne_raw < n_hall_floor then n_hall_floor else ne_raw
  let rh = 0.0 + run_hall
  let hc = rh * bt / (ne * e_charge)
  let pep = float_arr_get scr (scr_parr + j * mp_nz + i + 1)
  let pem = float_arr_get scr (scr_parr + j * mp_nz + i - 1)
  let dpe_dz = 0.5 * (pep - pem) / (2.0 * mp_dz)
  let pjp = float_arr_get scr (scr_parr + (j + 1) * mp_nz + i)
  let pjm = float_arr_get scr (scr_parr + (j - 1) * mp_nz + i)
  let dpe_dr = 0.5 * (pjp - pjm) / (2.0 * mp_dr)
  let inv_nee = rh / (ne * e_charge)
  let _ = float_arr_set scr k (0.0 - jz * hc - dpe_dr * inv_nee)
  float_arr_set scr (scr_ez + k) (jr * hc - dpe_dz * inv_nee)

mv_parr_loop st scr ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set scr (scr_parr + ji) (mv_pressure st (ji / mp_nz) (ji % mp_nz))
    mv_parr_loop st scr (ji + 1)

mv_efield_loop st scr unused ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let ok1 = if j >= 1 then j <= mp_nrm2 else false
    let ok = if ok1 then (if i >= 1 then i <= mp_nzm2 else false) else false
    let _ = if ok then mv_efield_cell st scr j i else 0
    mv_efield_loop st scr unused (ji + 1)

mv_induct_cell ns scr dt j i =
  let dez_dr = (float_arr_get scr (scr_ez + (j + 1) * mp_nz + i) - float_arr_get scr (scr_ez + (j - 1) * mp_nz + i)) / (2.0 * mp_dr)
  let der_dz = (float_arr_get scr (j * mp_nz + i + 1) - float_arr_get scr (j * mp_nz + i - 1)) / (2.0 * mp_dz)
  mp_put ns mp_f_bt j i (mp_get ns mp_f_bt j i + dt * (dez_dr - der_dz))

-- induction stencil needs E at j+-1, i+-1 which needs the E stencil
-- valid there: interior band j in [2, mp_nrm2-1], i in [2, mp_nzm2-1]
mv_induct_loop ns m scr dt ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let ok1 = if j >= 2 then j <= 127 else false
    let ok2 = if i >= 2 then i <= 103 else false
    let ok3 = if ok1 then ok2 else false
    let ok = if ok3 then arr_get m ji == 0 else false
    let _ = if ok then mv_induct_cell ns scr dt j i else 0
    mv_induct_loop ns m scr dt (ji + 1)

-- ── dt ──
mv_vmax_loop st m ji acc =
  if ji >= mp_nrnz then 1.0 * float_arr_get acc 0
  else
    let _ = if arr_get m ji == 0 then
        -- 1.0 * forces float typing of the user-fn result (marker quirk);
        -- without it the max-comparison runs on mistyped values
        let v = 1.0 * mv_speed st (ji / mp_nz) (ji % mp_nz)
        let cur = float_arr_get acc 0
        if v > cur then float_arr_set acc 0 v else 0
      else 0
    mv_vmax_loop st m (ji + 1) acc

mv_dt st m =
  let acc = float_arr_new 1 1.0
  let vmax = 1.0 * mv_vmax_loop st m 0 acc
  -- no resistive limit: diffusion is implicit (unconditionally stable)
  let d1 = cfl_c * mp_dr / vmax
  let rh = 0.0 + run_hall
  if rh > 0.5 then
    -- whistler limit at the Hall density floor and current max B scale
    let bmax = mv_bmax st m
    let bs = if bmax < 0.001 then 0.001 else bmax
    let dh = 0.1 * mp_dr * mp_dr * mu0 * n_hall_floor * e_charge / bs
    if dh < d1 then dh else d1
  else d1

mv_bmax_loop st m ji acc =
  if ji >= mp_nrnz then float_arr_get acc 0
  else
    let _ = if arr_get m ji == 0 then
        let b = mp_get st mp_f_bt (ji / mp_nz) (ji % mp_nz)
        let ab = if b < 0.0 then 0.0 - b else b
        let cur = float_arr_get acc 0
        if ab > cur then float_arr_set acc 0 ab else 0
      else 0
    mv_bmax_loop st m (ji + 1) acc

mv_bmax st m =
  let acc = float_arr_new 1 0.0
  let _ = mv_bmax_loop st m 0 acc
  float_arr_get acc 0

-- ── resistive diffusion: operator-split IMPLICIT (Thomas per line) ──
--   dB/dt = d/dz(D dB/dz) + d/dr(D (1/r) d(rB)/dr),  D = eta/mu0.
-- One backward-Euler tridiagonal solve per fluid segment of each z-line,
-- then each r-line (Lie splitting, first order like the rest). Dirichlet
-- faces (btp of the non-fluid neighbor; masks 3/7 carry 0 there) enter as
-- ghost = 2*face - cell folded into the diagonal and RHS. Workspace lives
-- in scr at scr_tri_* (four 130-slot lanes: sub, diag, super, rhs).

scr_tri_a = 41341
scr_tri_b = 41471
scr_tri_c = 41601
scr_tri_d = 41731

-- z-line coefficients for the fluid segment (j, i0 .. i0+n-1)
mv_zco ns scr dt j i0 n p =
  if p >= n then 0
  else
    let i = i0 + p
    let ec = 1.0 * mv_eta ns j i
    let em = if p == 0 then ec else
        let e2 = 1.0 * mv_eta ns j (i - 1)
        0.5 * (ec + e2)
    let ep = if p == n - 1 then ec else
        let e3 = 1.0 * mv_eta ns j (i + 1)
        0.5 * (ec + e3)
    let dm = em * inv_mu0
    let dp = ep * inv_mu0
    let lam = dt / (mp_dz * mp_dz)
    let _ = float_arr_set scr (scr_tri_a + p) (0.0 - lam * dm)
    let _ = float_arr_set scr (scr_tri_c + p) (0.0 - lam * dp)
    let _ = float_arr_set scr (scr_tri_b + p) (1.0 + lam * (dm + dp))
    let _ = float_arr_set scr (scr_tri_d + p) (mp_get ns mp_f_bt j i)
    mv_zco ns scr dt j i0 n (p + 1)

-- r-line coefficients for the fluid segment (j0 .. j0+n-1, i).
-- A segment starting at j0 == 1 abuts the axis: the inner-face flux uses
-- g = 2B/r (exact for B ~ r, which is the physical axis behavior), no
-- Dirichlet fold there. rfm = 0 at j = 1 makes the generic form singular,
-- hence the branch.
mv_rco ns scr dt i j0 n p =
  if p >= n then 0
  else
    let j = j0 + p
    let r = mp_r_of j
    let ec = 1.0 * mv_eta ns j i
    let em = if p == 0 then ec else
        let e2 = 1.0 * mv_eta ns (j - 1) i
        0.5 * (ec + e2)
    let ep = if p == n - 1 then ec else
        let e3 = 1.0 * mv_eta ns (j + 1) i
        0.5 * (ec + e3)
    let dm = em * inv_mu0
    let dp = ep * inv_mu0
    let lam = dt / (mp_dr * mp_dr)
    let rfp = r + 0.5 * mp_dr
    let rp = r + mp_dr
    let _ = float_arr_set scr (scr_tri_c + p) (0.0 - lam * dp * rp / rfp)
    let ax = if p == 0 then j == 1 else false
    let _ = if ax then
        let _ = float_arr_set scr (scr_tri_a + p) 0.0
        float_arr_set scr (scr_tri_b + p) (1.0 + lam * r * dp / rfp + dt * 2.0 * dm / (mp_dr * r))
      else
        let rfm = r - 0.5 * mp_dr
        let rm = r - mp_dr
        let _ = float_arr_set scr (scr_tri_a + p) (0.0 - lam * dm * rm / rfm)
        float_arr_set scr (scr_tri_b + p) (1.0 + lam * r * (dp / rfp + dm / rfm))
    let _ = float_arr_set scr (scr_tri_d + p) (mp_get ns mp_f_bt j i)
    mv_rco ns scr dt i j0 n (p + 1)

-- Dirichlet fold-in at the segment ends (ghost = 2*face - cell)
mv_tri_dir_l scr bf =
  let a0 = float_arr_get scr scr_tri_a
  let _ = float_arr_set scr scr_tri_b (float_arr_get scr scr_tri_b - a0)
  let _ = float_arr_set scr scr_tri_d (float_arr_get scr scr_tri_d - 2.0 * a0 * bf)
  float_arr_set scr scr_tri_a 0.0

mv_tri_dir_r scr n bf =
  let cn = float_arr_get scr (scr_tri_c + n - 1)
  let _ = float_arr_set scr (scr_tri_b + n - 1) (float_arr_get scr (scr_tri_b + n - 1) - cn)
  let _ = float_arr_set scr (scr_tri_d + n - 1) (float_arr_get scr (scr_tri_d + n - 1) - 2.0 * cn * bf)
  float_arr_set scr (scr_tri_c + n - 1) 0.0

mv_thomas_fwd scr n p =
  if p >= n then 0
  else
    let w = float_arr_get scr (scr_tri_a + p) / float_arr_get scr (scr_tri_b + p - 1)
    let _ = float_arr_set scr (scr_tri_b + p) (float_arr_get scr (scr_tri_b + p) - w * float_arr_get scr (scr_tri_c + p - 1))
    let _ = float_arr_set scr (scr_tri_d + p) (float_arr_get scr (scr_tri_d + p) - w * float_arr_get scr (scr_tri_d + p - 1))
    mv_thomas_fwd scr n (p + 1)

-- write one solved value with the magnetic-energy pairing (per-sweep
-- pairings telescope to the exact me change; p untouched by transport)
mv_diff_write ns j i x =
  let bold = mp_get ns mp_f_bt j i
  let db = x - bold
  let dme = (bold * db + 0.5 * db * db) * inv_mu0
  let _ = mp_put ns mp_f_en j i (mp_get ns mp_f_en j i + dme)
  mp_put ns mp_f_bt j i x

mv_zback ns scr j i0 p xn =
  if p < 0 then 0
  else
    let x = (float_arr_get scr (scr_tri_d + p) - float_arr_get scr (scr_tri_c + p) * xn) / float_arr_get scr (scr_tri_b + p)
    let _ = mv_diff_write ns j (i0 + p) x
    mv_zback ns scr j i0 (p - 1) x

mv_rback ns scr i j0 p xn =
  if p < 0 then 0
  else
    let x = (float_arr_get scr (scr_tri_d + p) - float_arr_get scr (scr_tri_c + p) * xn) / float_arr_get scr (scr_tri_b + p)
    let _ = mv_diff_write ns (j0 + p) i x
    mv_rback ns scr i j0 (p - 1) x

-- last fluid index of the run starting at a known-fluid cell
mv_zrun m j i =
  if i >= mp_nzm2 then mp_nzm2
  else if arr_get m (j * mp_nz + i + 1) == 0 then mv_zrun m j (i + 1)
  else i

mv_rrun m i j =
  if j >= mp_nrm2 then mp_nrm2
  else if arr_get m ((j + 1) * mp_nz + i) == 0 then mv_rrun m i (j + 1)
  else j

mv_zscan ns btp m scr dt j i =
  if i > mp_nzm2 then 0
  else if arr_get m (j * mp_nz + i) == 0 then
    let i1 = mv_zrun m j i
    let n = i1 - i + 1
    let _ = mv_zco ns scr dt j i n 0
    let _ = mv_tri_dir_l scr (float_arr_get btp (j * mp_nz + i - 1))
    let _ = mv_tri_dir_r scr n (float_arr_get btp (j * mp_nz + i1 + 1))
    let _ = mv_thomas_fwd scr n 1
    let _ = mv_zback ns scr j i (n - 1) 0.0
    mv_zscan ns btp m scr dt j (i1 + 2)
  else mv_zscan ns btp m scr dt j (i + 1)

mv_rscan ns btp m scr dt i j =
  if j > mp_nrm2 then 0
  else if arr_get m (j * mp_nz + i) == 0 then
    let j1 = mv_rrun m i j
    let n = j1 - j + 1
    let _ = mv_rco ns scr dt i j n 0
    let _ = if j == 1 then 0.0 else mv_tri_dir_l scr (float_arr_get btp ((j - 1) * mp_nz + i))
    let _ = mv_tri_dir_r scr n (float_arr_get btp ((j1 + 1) * mp_nz + i))
    let _ = mv_thomas_fwd scr n 1
    let _ = mv_rback ns scr i j (n - 1) 0.0
    mv_rscan ns btp m scr dt i (j1 + 2)
  else mv_rscan ns btp m scr dt i (j + 1)

mv_zsweep ns btp m scr dt j =
  if j > mp_nrm2 then 0
  else
    let _ = mv_zscan ns btp m scr dt j 1
    mv_zsweep ns btp m scr dt (j + 1)

mv_rsweep ns btp m scr dt i =
  if i > mp_nzm2 then 0
  else
    let _ = mv_rscan ns btp m scr dt i 1
    mv_rsweep ns btp m scr dt (i + 1)

-- explicit Ohmic heating dt eta j^2 (post-diffusion field; stencils at
-- boundary-adjacent cells read the previous fill of the ghost cells,
-- one operator stale, first-order like every source here)
mv_heat_cell ns dt j i =
  let et = 1.0 * mv_eta ns j i
  let jr = 1.0 * mv_jr ns j i
  let jz = 1.0 * mv_jz ns j i
  mp_put ns mp_f_en j i (mp_get ns mp_f_en j i + dt * et * (jr * jr + jz * jz))

mv_heat_loop ns m dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_heat_cell ns dt (ji / mp_nz) (ji % mp_nz) else 0.0
    mv_heat_loop ns m dt (ji + 1)

-- vacuum guard: state density floor + velocity cap (rescale momenta).
-- The pinch evacuates the near-cathode region; without this the Alfven
-- speed there collapses dt. facc[0] accumulates the mass ADDED by the
-- floor (kg) so the budget is reported, not silent.
rho_min_state = 0.000001
v_cap = 100000.0

scr_fmass = 41340

mv_floor_cell ns facc j i =
  let rho = mp_get ns mp_f_rho j i
  let _ = if rho < rho_min_state then
      let dv = 6.283185307179586 * mp_r_of j * mp_dr * mp_dz
      let _ = float_arr_set facc scr_fmass (float_arr_get facc scr_fmass + (rho_min_state - rho) * dv)
      mp_put ns mp_f_rho j i rho_min_state
    else 0.0
  let rho2 = mp_get ns mp_f_rho j i
  let mr = mp_get ns mp_f_mr j i
  let mz = mp_get ns mp_f_mz j i
  let v = sqrt ((mr * mr + mz * mz) / (rho2 * rho2))
  if v > v_cap then
    let sc = v_cap / v
    let _ = mp_put ns mp_f_mr j i (mr * sc)
    mp_put ns mp_f_mz j i (mz * sc)
  else 0.0

mv_floor_loop ns m facc ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then mv_floor_cell ns facc (ji / mp_nz) (ji % mp_nz) else 0
    mv_floor_loop ns m facc (ji + 1)

-- checkpoint: full state as one f32 payload (f32 truncation ~1e-7 rel,
-- fine for resume; NOT for attestation)
mv_save_state path st = float_arr_to_f32_file path st mp_state
mv_load_state path st = float_arr_from_f32_file path st mp_state

-- ── mass bookkeeping (the conservation gate's currency) ──
mv_tau = 6.283185307179586

mv_mass_loop st m ji acc =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then
        let rho = float_arr_get st ji
        float_arr_set acc 0 (float_arr_get acc 0 + rho * mv_tau * mp_r_of (ji / mp_nz) * mp_dr * mp_dz)
      else 0
    mv_mass_loop st m (ji + 1) acc

mv_total_mass st m =
  let acc = float_arr_new 1 0.0
  let _ = mv_mass_loop st m 0 acc
  float_arr_get acc 0

-- Boundary mass rate (kg/s INTO the domain), using the scheme's exact
-- face fluxes: r-faces carry area 2 pi r_f dz (r_f = 0 kills the axis
-- face), z-faces 2 pi r_j dr. Ghosts must be applied first. With the
-- conservative interior, d(total mass)/dt == this + floor additions,
-- to rounding - selftest check 26 holds that equality per step.
mv_bmass_face st m acc dt j i dj di =
  let mk = arr_get m ((j + dj) * mp_nz + i + di)
  if mk == 0 then 0.0
  else
    let r = mp_r_of j
    let rc = mp_get st mp_f_rho j i
    let rg = mp_get st mp_f_rho (j + dj) (i + di)
    let rate = if dj == 0 then
        let fc = mp_get st mp_f_mz j i
        let fg = mp_get st mp_f_mz (j + dj) (i + di)
        let fh = 0.5 * (fc + fg) - (mp_dz / (4.0 * dt)) * to_float di * (rg - rc)
        (0.0 - to_float di) * fh * mv_tau * r * mp_dr
      else
        let rf = r + to_float dj * 0.5 * mp_dr
        let fc = mp_get st mp_f_mr j i
        let fg = mp_get st mp_f_mr (j + dj) (i + di)
        let fh = 0.5 * (fc + fg) - (mp_dr / (4.0 * dt)) * to_float dj * (rg - rc)
        (0.0 - to_float dj) * fh * mv_tau * rf * mp_dz
    float_arr_set acc 0 (float_arr_get acc 0 + rate)

mv_bmass_loop st m acc dt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = if arr_get m ji == 0 then
        let j = ji / mp_nz
        let i = ji % mp_nz
        let _ = mv_bmass_face st m acc dt j i 1 0
        let _ = mv_bmass_face st m acc dt j i (0 - 1) 0
        let _ = mv_bmass_face st m acc dt j i 0 1
        mv_bmass_face st m acc dt j i 0 (0 - 1)
      else 0.0
    mv_bmass_loop st m acc dt (ji + 1)

mv_bmass_rate st m dt =
  let acc = float_arr_new 1 0.0
  let _ = mv_bmass_loop st m acc dt 0
  float_arr_get acc 0

-- ── one full step ──
-- Order (Lie splitting): implicit resistive sweeps + Ohmic heat in-place
-- on st, then ghosts, then hyperbolic st -> ns (+ explicit Hall), floor.
-- ns and scratch are caller-owned and reused (no per-step allocation; the
-- caller double-buffers st <-> ns). fb: 20-float flux scratch. scr: one
-- 41861-float array carved by offset (er 0, ez +13780, parr +27560,
-- fmass 41340, tridiagonal lanes 41341..41860).
mv_step st ns btp m fb scr dt =
  let _ = mv_zsweep st btp m scr dt 1
  let _ = mv_rsweep st btp m scr dt 1
  let _ = mv_heat_loop st m dt 0
  let _ = mv_apply_ghosts st btp m
  let cr = dt / (2.0 * mp_dr)
  let cz = dt / (2.0 * mp_dz)
  let _ = mv_lxf_loop st ns m cr cz fb 0
  let _ = mv_geom_loop st ns m dt 0
  let rh = 0.0 + run_hall
  let _ = if rh > 0.5 then
      let _ = mv_parr_loop st scr 0
      let _ = mv_efield_loop st scr 0 0
      mv_induct_loop ns m scr dt 0
    else 0
  mv_floor_loop ns m scr 0

scr_ez = 13780
scr_parr = 27560

-- ── init ──
-- GAS PREFILL at 300 K (2026-08-31 night): a cold start from amb_rho
-- (3e-5) with the full 8 kA field is a death spiral - the field pumps
-- the chamber out faster than the choked inlet can feed it, rho falls,
-- v_A rises, dt collapses (out/phase2_cold1.log: mass 8x down, vmax
-- 110k, dt 1.4e-9 after 60k steps). Real devices flow gas BEFORE the
-- arc. fill_rho ~ the expected steady mean (mass ~4e-6 kg over ~1.3e-3
-- m^3); the steady state does not depend on the init, and the prefill
-- also lowers init v_A ~15x, so dt0 is ~7x bigger.
fill_rho = 0.002

mv_init_cell st jtot ji =
  let j = ji / mp_nz
  let i = ji % mp_nz
  let r = mp_r_of j
  let ra = if r < 0.0005 then 0.0005 else r
  let g = 1.0 - mp_z_of i / 0.13
  -- enclosed-current-consistent ramp: I -> 0 at the axis, ~J outside r_c
  let ifrac = ra * ra / (ra * ra + pbt_r_c * pbt_r_c)
  let bt = mu0_2pi * jtot * g * ifrac / ra
  let me = 0.5 * bt * bt * inv_mu0
  let _ = mp_put st mp_f_rho j i fill_rho
  let _ = mp_put st mp_f_mr j i 0.0
  let _ = mp_put st mp_f_mz j i 0.0
  let _ = mp_put st mp_f_en j i (fill_rho * kT_m / gamma_m1 + me)
  mp_put st mp_f_bt j i bt

mv_init_loop st jtot ji =
  if ji >= mp_nrnz then 0
  else
    let _ = mv_init_cell st jtot ji
    mv_init_loop st jtot (ji + 1)

mv_init jtot =
  let st = float_arr_new mp_state 0.0
  let _ = mv_init_loop st jtot 0
  st

-- copy the bt block into a standalone array for stress_diag
mv_bt_slice st bt ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set bt ji (float_arr_get st (4 * mp_nrnz + ji))
    mv_bt_slice st bt (ji + 1)

mv_extract_bt st =
  let bt = float_arr_new mp_nrnz 0.0
  let _ = mv_bt_slice st bt 0
  bt
