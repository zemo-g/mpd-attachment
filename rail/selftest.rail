-- rail/selftest.rail -- Phase 0/1 guards. Prints SELFTEST PASS or SELFTEST FAIL.
-- Do not rely on the exit code (rail_native run historically swallowed it);
-- callers grep the last line.
--
-- Guards:
--   transcription of the Table 2 fits (spot values cross-checked against the
--   JPP-2001 scatter plots by eye, tolerance covers the readout)
--   the I_fi = J_ci coincidence check case from the program doc
--   digitized fig-1 anchor points
--   scoreboard output sanity

import "rail/pbt.rail"
import "rail/semi_lib.rail"
import "rail/mhd_pbt.rail"
import "rail/stress_diag.rail"
import "rail/mpd_solver.rail"

run_hall = 0.0

near v target tol = fabs (v - target) < tol

-- set the near-inlet fluid row to a given density (selftest 33)
st_set_inrow stx mm v j =
  if j >= mp_nr then 0.0
  else
    let _ = if arr_get mm (j * mp_nz) == 6 then mp_put stx mp_f_rho j 1 v
            else 0.0
    st_set_inrow stx mm v (j + 1)

check name ok fails =
  if ok then fails
  else
    let _ = print (cat ["  FAIL: ", name])
    fails + 1

-- count scoreboard rows and range-check C_T
scan_rows lines n bad =
  if lines == [] then [n, bad]
  else
    let line = head lines
    let rest = tail lines
    if line == "" then scan_rows rest n bad
    else
      let f = split "," line
      let ct = parse_float (nth 4 f)
      let sg = parse_float (nth 5 f)
      let ok1 = if ct > 1.5 then ct < 8.0 else false
      let ok = if ok1 then sg > 0.0 else false
      scan_rows rest (n + 1) (if ok then bad else bad + 1)

-- find a digitized 3 g/s point near (3238, 6.857)
find_anchor lines =
  if lines == [] then false
  else
    let line = head lines
    if line == "" then find_anchor (tail lines)
    else
      let f = split "," line
      let j = parse_float (nth 0 f)
      let ct = parse_float (nth 1 f)
      let hit1 = if near j 3238.0 60.0 then near ct 6.857 0.15 else false
      if hit1 then true else find_anchor (tail lines)

main =
  let f0 = 0
  -- geometry-derived constants
  let f1 = check "maecker C_T = 2.4305" (near maecker_ct 2.4305 0.001) f0
  -- program-doc check case: I_fi(argon, 660 mg/s, b=1.8e-7) ~ 5600 A,
  -- same quantity as J_ci
  let ifi = sqrt (0.00066 * uci_argon / 1.8e-7)
  let f2 = check "I_fi check case ~5600 A" (near ifi 5600.0 100.0) f1
  -- Table 2 transcription spot checks (values also validated against scatter)
  let f3 = check "fit Ar1 T(6500)" (near (fit_t_ar1 6500.0) 8.2 0.6) f2
  let f4 = check "fit Ar3 T(15000)" (near (fit_t_ar3 15000.0) 44.4 1.5) f3
  let f5 = check "fit Ar6 T(20000)" (near (fit_t_ar6 20000.0) 82.8 1.5) f4
  let f6 = check "fit Xe3 T(10000)" (near (fit_t_xe3 10000.0) 20.9 1.0) f5
  let f7 = check "fit Xe6 T(20000)" (near (fit_t_xe6 20000.0) 82.0 2.0) f6
  -- Xe6 a5 exponent regression guard (e-14 turns T(7500) negative)
  let f8 = check "fit Xe6 T(7500) positive" (fit_t_xe6 7500.0 > 10.0) f7
  -- xi relation: xi^2 INSIDE the log (outside gives 2.77 at xi=1, 6 g/s)
  let f9 = check "choueiri_ct(6 g/s, xi=1) in 1.85..2.00"
             (near (choueiri_ct 6.0 1.0) 1.925 0.075) f8
  -- digitized data anchors
  let raw = read_file "data/fig1_points.csv"
  let dlines = tail (split "\n" raw)
  let f10 = check "fig1 anchor (3238, 6.857)" (find_anchor dlines) f9
  -- scoreboard sanity
  let sraw = read_file "out/measured_ct.csv"
  let slines = tail (split "\n" sraw)
  let nb = scan_rows slines 0 0
  let f11 = check "scoreboard >= 240 rows" (nth 0 nb >= 240) f10
  let f12 = check "scoreboard C_T in (1.5, 8), sigma > 0" (nth 1 nb == 0) f11
  -- semi-empirical model guards
  -- eq 22 parabolic-profile identity: mean-pressure form == direct a,b form
  let bp1 = tp_bp 1500.0 700.0
  let bp2 = tp_bp_direct 1500.0 700.0
  let f13 = check "tp_bp identity (mean-pressure == a,b form)"
              (fabs (bp1 - bp2) < 0.0000001) f12
  -- backplate blowing in C_T units is exactly ln(r_ch/r_c)
  let v16k = tb_bp 16000.0
  let f14 = check "BP blowing C_T = ln(rch/rc)"
              (near (v16k / (mu0_4pi * 256000000.0)) 1.90759 0.0001) f13
  -- eq 23 ln variant lock: with ln(ra/rch), inferred p_rc tracks Cory's
  -- p_rch in the 12-16 kA band (the printed ln(ra/rc) goes NEGATIVE there)
  let t12 = fit_t_ar6 12000.0
  let t16 = fit_t_ar6 16000.0
  let p12 = infer_p_rc t12 12000.0 ln_ch
  let p16 = infer_p_rc t16 16000.0 ln_ch
  let c12 = cory_p_rch 12000.0
  let c16 = cory_p_rch 16000.0
  -- 1.0 * forces float typing of the user-fn results (marker quirk)
  let r12 = 1.0 * p12 / c12
  let r16 = 1.0 * p16 / c16
  let ok12 = if r12 > 0.7 then r12 < 1.3 else false
  let ok16 = if r16 > 0.7 then r16 < 1.3 else false
  let f15 = check "p_rc(lnch) tracks Cory at 12 kA" ok12 f14
  let f16 = check "p_rc(lnch) tracks Cory at 16 kA" ok16 f15
  -- flat backplate profile cannot reproduce the low-current rise:
  -- at 7195 A (fig1 point, measured C_T 4.18) flat lands below 3.0
  let rest7 = t_rest 7195.0 ln_ch
  let flat7 = tp_bp (cory_p_rch 7195.0) (cory_p_rch 7195.0)
  let ctf7 = (rest7 + flat7) / (mu0_4pi * 7195.0 * 7195.0)
  let f17 = check "flat profile misses low-current rise" (ctf7 < 3.0) f16
  -- phase 2 layer-0 guards: stress-identity machinery on the PBT grid
  let m = mp_build_mask
  let bt1 = float_arr_new mp_nrnz 0.0
  let _ = st_fill_an bt1 8000.0 0
  let tv = 1.0 * sd_volume_integral bt1 m
  let sg1 = sd_surface_integral bt1 m
  let ts = float_arr_get sg1 0 + float_arr_get sg1 1 + float_arr_get sg1 2 + float_arr_get sg1 3 + float_arr_get sg1 4
  let f18 = check "stress identity (analytic field) < 1e-6"
              (fabs (tv / ts - 1.0) < 0.000001) f17
  let btp = mp_build_btp 8000.0
  let bt3 = float_arr_new mp_nrnz 0.0
  let _ = st_fill_dec bt3 8000.0 0
  let _ = sd_fill_ghosts bt3 btp m
  let sg3 = sd_surface_integral bt3 m
  let bp_ref = mu0_4pi * log (pbt_r_ch / pbt_r_c) * 64000000.0
  let aif_ref = tb_aif 8000.0
  let f19 = check "surface BP matches eq 13 (1e-3)"
              (fabs (float_arr_get sg3 0 / bp_ref - 1.0) < 0.001) f18
  let f20 = check "surface AIF matches eq 14 (1%)"
              (fabs (float_arr_get sg3 2 / aif_ref - 1.0) < 0.01) f19
  -- the prescription-as-constant compiler-bug guard: tip btp must be sane
  let tipv = 1.0 * float_arr_get btp (19 * mp_nz + 80)
  let f21 = check "tip prescription sane (compiler-bug guard)"
              (near tipv 0.0328 0.001) f20
  -- implicit-diffusion guards: the Thomas solve must preserve the exact
  -- steady profiles of each 1D operator (any eta field for c/r since its
  -- flux g = (1/r) d(rB)/dr is identically zero; uniform eta for the
  -- others -- mv_init gives uniform p and rho, so the line fills rebuild
  -- en to keep p = amb_p exactly)
  let jt2 = 0.0 + 8000.0
  let stx = mv_init jt2
  let scr2 = float_arr_new 55647 0.0
  -- mv_rco/mv_zco read eta from the scr cache since the 2026-09-01
  -- caching pass: fill it or the operators run with eta = 0 and checks
  -- 23-25 pass VACUOUSLY (nothing diffuses, profiles trivially held).
  -- One fill is exact here: the st_line_* fills keep e_int uniform.
  let _ = mv_eta_loop stx scr2 0
  let dtbig = 1.0
  -- (22) r-solve, coax vacuum field c/r on j = 20..128 at i = 40
  let _ = st_line_rinv stx 40 20
  let _ = mv_rco stx scr2 dtbig 40 20 109 0
  let _ = mv_tri_dir_l scr2 (0.001 / pbt_r_c)
  let _ = mv_tri_dir_r scr2 109 (0.001 / pbt_r_ch)
  let _ = mv_thomas_fwd scr2 109 1
  let _ = mv_rback stx scr2 40 20 108 0.0
  -- c/r has curvature, and the ghost fold is linear extrapolation, so
  -- preservation here is boundary-order (O(dr^2/r^2) at the cathode
  -- face), not exact -- the tolerance reflects that
  let b70 = mp_get stx mp_f_bt 70 40
  let r70 = mp_r_of 70
  let f22 = check "implicit r-solve holds c/r to boundary order"
              (fabs (b70 * r70 / 0.001 - 1.0) < 0.005) f21
  -- (23) z-solve, linear profile on i = 1..104 at j = 60
  let _ = st_line_zlin stx 60 1
  let _ = mv_zco stx scr2 dtbig 60 1 104 0
  let _ = mv_tri_dir_l scr2 0.001
  let _ = mv_tri_dir_r scr2 104 0.0023
  let _ = mv_thomas_fwd scr2 104 1
  let _ = mv_zback stx scr2 60 1 103 0.0
  let b52 = mp_get stx mp_f_bt 60 52
  let z52 = mp_z_of 52
  let f23 = check "implicit z-solve preserves linear profile"
              (fabs (b52 / (0.001 + 0.01 * z52) - 1.0) < 0.000000001) f22
  -- (24) axis regularization, B = alpha r on j = 1..128 at i = 100
  let _ = st_line_alr stx 100 1
  let _ = mv_rco stx scr2 dtbig 100 1 128 0
  let _ = mv_tri_dir_r scr2 128 (0.01 * pbt_r_ch)
  let _ = mv_thomas_fwd scr2 128 1
  let _ = mv_rback stx scr2 100 1 127 0.0
  let b64 = mp_get stx mp_f_bt 64 100
  let r64 = mp_r_of 64
  let f24 = check "implicit axis solve preserves B ~ r"
              (fabs (b64 / (0.01 * r64) - 1.0) < 0.000000001) f23
  -- (25) B = alpha r again but through BOTH Dirichlet folds (j = 20..128
  -- at i = 40; linear extrapolation is exact on a linear profile, so this
  -- one IS exact): locks the fold-in coefficients
  let _ = st_line_alr stx 40 1
  let _ = mv_rco stx scr2 dtbig 40 20 109 0
  let _ = mv_tri_dir_l scr2 (0.01 * pbt_r_c)
  let _ = mv_tri_dir_r scr2 109 (0.01 * pbt_r_ch)
  let _ = mv_thomas_fwd scr2 109 1
  let _ = mv_rback stx scr2 40 20 108 0.0
  let b90 = mp_get stx mp_f_bt 90 40
  let r90 = mp_r_of 90
  let f25 = check "implicit r-solve exact on B ~ r through both folds"
              (fabs (b90 / (0.01 * r90) - 1.0) < 0.000000001) f24
  -- (26) mass-conservation gate: the interior creates NOTHING. After 50
  -- real solver steps from cold init, one more step's change in total
  -- mass must equal dt * (boundary flux rate) - the defect this guards
  -- against manufactured ~7e-3 kg/s on the pre-conservative scheme
  -- (2026-08-31). The floor accumulator must also stay 0.
  -- mc_run recomputes dt EVERY step (the partially-ionized eta makes the
  -- cold-start ignition transient violent enough that a frozen dt
  -- detonates within 50 steps; the real runner adapts dt too). The gate
  -- itself is unchanged: one measured step, dm == dt * boundary rate,
  -- and the floor must not fire DURING that step.
  let stq = mv_init jt2
  let nsq0 = mv_init jt2
  let fbq = float_arr_new 42 0.0
  let scrq = float_arr_new 55647 0.0
  let stw = mc_run stq nsq0 btp m fbq scrq 0.0 50
  let _ = mv_apply_ghosts stw btp m
  let dtq = 1.0 * mv_dt stw m
  -- the exit face state depends on p (2026-09-05), so the boundary rate
  -- is read after the resistive phase, on the state the hyperbolic
  -- phase sees (mass is untouched by the resistive phase)
  let _ = mv_step_res stw btp m fbq scrq dtq
  let _ = mv_apply_ghosts stw btp m
  let m0 = 1.0 * mv_total_mass stw m
  let br = 1.0 * mv_bmass_rate stw m dtq
  let fm0 = float_arr_get scrq scr_fmass
  let nsw = float_arr_new mp_state 0.0
  let _ = mv_step_hyp stw nsw btp m fbq scrq dtq
  let m1 = 1.0 * mv_total_mass nsw m
  let dm = m1 - m0
  let pred = dtq * br
  let okm = fabs (dm - pred) < fabs pred * 0.000001 + 1.0e-18
  let ok26 = if okm then float_arr_get scrq scr_fmass == fm0 else false
  let f26 = check "one-step mass conservation (interior creates nothing)" ok26 f25
  -- (27..29) Saha EOS guards (2026-09-01). References computed
  -- independently in Python from CODATA constants (chi = 15.759611 eV,
  -- U_i/U_0 = 6); see the eos_* block in mpd_solver.rail.
  -- (27) cold limit is EXACTLY the ideal gas (no exp paid, no drift)
  let nref = 0.0 + 3.0e22
  let ec27 = 1.5 * nref * k_boltz * 400.0
  let t27 = 1.0 * eos_temp nref ec27
  let f27 = check "EOS cold limit exact (T=400)"
              (fabs (t27 / 400.0 - 1.0) < 0.000000000001) f26
  -- (28) Saha alpha spot value in the band
  let a28 = 1.0 * eos_alpha nref 12000.0
  let f28 = check "Saha alpha(3e22, 12000 K) = 0.4206663"
              (near a28 0.4206663108 0.000001) f27
  -- (29) inversion round-trip through the steep band: T -> e_int -> T
  let e29 = 1.0 * eos_e nref 15000.0
  let t29 = 1.0 * eos_temp nref e29
  let f29 = check "EOS round-trip at T=15000"
              (fabs (t29 / 15000.0 - 1.0) < 0.00001) f28
  -- (30..31) partially-ionized eta (Python refs from the same constants:
  -- n = 3e22, sigma_en = 1e-19). 30: weakly ionized band, e-n dominated.
  -- 31: fully ionized limit collapses to pure Spitzer.
  let ste = mv_init jt2
  let _ = mp_put ste mp_f_rho 60 50 0.0019899
  let _ = mp_put ste mp_f_bt 60 50 0.0
  let _ = mp_put ste mp_f_en 60 50 8399.1649143
  let et30 = 1.0 * mv_eta_calc ste 60 50
  -- References re-derived 2026-09-01 late for the Coulomb logarithm
  -- (NRL ln(Lambda) = 23 - ln(sqrt(n_e[cm^-3]) / T_eV^1.5)): at n =
  -- 3e22, T = 9000 K alpha = 0.03452, ln(Lambda) = 5.332, eta_ei =
  -- 4.0594e-4 + eta_en 5.8503e-5; at T = 50000 K (alpha = 1)
  -- ln(Lambda) = 6.221, eta = 3.6170e-5. The old 1.317e-4 / 5.59e-6
  -- were the ln(Lambda) = 0.96 coefficient (claim 001a).
  -- 2026-09-05: sigma_en(T) replaces the constant 1e-19; at 9000 K
  -- (0.7756 eV) the Maxwellian-averaged argon cross section is
  -- 2.8645e-20 (log-log between the 0.7 and 1.0 eV nodes), so
  -- eta_en = 5.8503e-5 x 0.28645 = 1.6758e-05; eta_ei unchanged (bt = 0,
  -- x = 0 keeps the parallel value). Python reference 4.226983e-04.
  let f30 = check "eta partially-ionized (T=9000) = 4.2270e-04"
              (fabs (et30 / 4.2269826484e-04 - 1.0) < 0.001) f29
  let _ = mp_put ste mp_f_en 60 50 137877.86303
  let et31 = 1.0 * mv_eta_calc ste 60 50
  let f31 = check "eta fully-ionized limit = Spitzer lnL 6.22: 3.617e-5"
              (fabs (et31 / 0.000036169828934 - 1.0) < 0.001) f30
  -- (32..33) inlet guards (2026-09-01). History: the metered ghost's
  -- velocity cap engaged on the reflected MOMENTUM and silently clipped
  -- 19 of 29 inlet rows for three segments; gating it on near-vacuum
  -- fluid then engaged anyway in every second-order segment (half the
  -- rows at 5% of nominal, mdot_in 6.0e-3 -> 2.87e-3), because the
  -- less-diffusive scheme evacuates the near-inlet gas. The inlet is
  -- now a PRESCRIBED-FLUX face (mv_face_zin): 32 holds the counter
  -- exact at operating density; 33 holds the face the scheme actually
  -- consumes exact on a VACUUM inlet cell (S = 2 rho_in v_in, jump 0),
  -- and the counter agreeing. 0.00599999578365988 is the geometric
  -- nominal: the inlet area sum is discretized, so it is not exactly
  -- 0.006 and must not be "fixed" to it.
  let sti = mv_init jt2
  let _ = mv_apply_ghosts sti btp m
  let dti = 1.0 * mv_dt sti m
  let ri = 1.0 * mv_inlet_rate sti m dti
  let f32 = check "metered inlet exact at operating density"
              (fabs (ri / 0.00599999578365988 - 1.0) < 0.000001) f31
  -- drop the near-inlet gas to 1e-5 kg/m^3 (50x below the old vacuum
  -- gate): the prescribed face must still deliver exactly nominal
  let vac = 0.0 + 0.00001
  let _ = st_set_inrow sti m vac 0
  let _ = mv_apply_ghosts sti btp m
  let _ = mv_parr_loop sti scrq 0
  let _ = mv_face_z sti scrq m fbq 25 0 15 35
  let s33 = float_arr_get fbq 15
  let d33 = float_arr_get fbq 35
  let rv = 1.0 * mv_inlet_rate sti m dti
  let f33 = check "prescribed inlet face exact on vacuum cell"
              (if fabs (s33 / 8.8242 - 1.0) < 0.000000000001
               then if d33 == 0.0
               then fabs (rv / 0.00599999578365988 - 1.0) < 0.000001
               else false else false) f32
  -- (34..35) MUSCL reconstruction guards (2026-09-01 second-order
  -- upgrade). 34: on linear data the face states are EXACT midpoints
  -- from both sides (second order in smooth regions). 35: at an
  -- extremum minmod clips the slope to zero, reverting to first order
  -- (TVD; no new extrema). Both are the properties the scheme's
  -- stability and its selftest-26 telescoping rest on.
  let l34a = 1.0 * mv_recl 1.0 3.0 5.0
  let r34a = 1.0 * mv_recr 3.0 5.0 7.0
  let f34 = check "minmod faces exact on linear data"
              (if fabs (l34a - 4.0) < 0.000000000001
               then fabs (r34a - 4.0) < 0.000000000001 else false) f33
  let l35a = 1.0 * mv_recl 1.0 5.0 3.0
  let r35a = 1.0 * mv_recr 5.0 1.0 3.0
  let f35 = check "minmod clips at extrema (first order)"
              (if fabs (l35a - 5.0) < 0.000000000001
               then fabs (r35a - 1.0) < 0.000000000001 else false) f34
  -- (36) wall sink: one application on a single hot cell adjacent to
  -- the cathode (j=20, i=40; only its r- face touches solid) must
  -- remove EXACTLY wall_kappa (T - t_wall) dt G with G = 2 r_f- /
  -- (r dr^2), leave total mass untouched, and book the same Joules
  -- (dE * cell volume) into the fb counter slot.
  let st36 = mv_init jt2
  let en0v = mp_get st36 mp_f_en 20 40
  let ei0 = 1.0 * mv_eint st36 20 40
  let eit = 0.0 + 8399.1649143
  let _ = mp_put st36 mp_f_en 20 40 (en0v - ei0 + eit)
  let m36a = 1.0 * mv_total_mass st36 m
  let fb36 = float_arr_new 42 0.0
  let dt36 = 0.0 + 1.0e-9
  let _ = mv_wall_loop st36 m fb36 dt36 0
  let m36b = 1.0 * mv_total_mass st36 m
  let rho36 = mp_get st36 mp_f_rho 20 40
  let t36 = 1.0 * eos_temp (rho36 / m_ion_ar) eit
  let r36 = 1.0 * mp_r_of 20
  let g36 = 2.0 * (r36 - 0.5 * mp_dr) / (r36 * mp_dr * mp_dr)
  let a36 = 1.0 * eos_alpha (rho36 / m_ion_ar) t36
  let k36 = 1.0 * wall_kappa (rho36 / m_ion_ar) a36 t36 (mp_get st36 mp_f_bt 20 40)
  let de36 = k36 * (t36 - t_wall) * dt36 * g36
  let got36 = eit - 1.0 * mv_eint st36 20 40
  let okde = fabs (got36 / de36 - 1.0) < 0.000000001
  let okm36 = m36b == m36a
  let vol36 = mv_tau * r36 * mp_dr * mp_dz
  let okfb = fabs (float_arr_get fb36 40 / (de36 * vol36) - 1.0) < 0.000000001
  let ok36 = if okde then if okm36 then okfb else false else false
  let f36 = check "wall sink analytic rate, mass untouched" ok36 f35
  -- (37) Ohmic counter: with bt = c r everywhere (including ghosts) the
  -- discrete jz is exactly 2 c / mu0 in every cell and jr = 0, so with a
  -- uniform eta cache one mv_heat_loop must book dt eta jz^2 V_fluid
  -- Joules into fb slot 41, where V_fluid is summed independently of
  -- the current stencil. It also must raise en by dt eta jz^2 per cell.
  let st37 = mv_init jt2
  let c37 = 0.0 + 0.5
  let _ = st37_fill st37 c37 0
  let scr37 = float_arr_new 55647 0.0
  let eta37 = 0.0 + 0.0001
  let _ = st37_eta scr37 eta37 0
  let fb37 = float_arr_new 42 0.0
  let dt37 = 0.0 + 1.0e-9
  let en37a = mp_get st37 mp_f_en 20 40
  let _ = mv_heat_loop st37 m scr37 fb37 dt37 0
  let en37b = mp_get st37 mp_f_en 20 40
  let jz37 = 2.0 * c37 * inv_mu0
  let vf37 = 1.0 * st37_vol m 0 0.0
  let want37 = dt37 * eta37 * jz37 * jz37 * vf37
  let okfb37 = fabs (float_arr_get fb37 41 / want37 - 1.0) < 0.000000001
  let oken37 = fabs ((en37b - en37a) / (dt37 * eta37 * jz37 * jz37) - 1.0) < 0.000000001
  let ok37 = if okfb37 then oken37 else false
  let f37 = check "Ohmic counter books dt eta j^2 V_fluid" ok37 f36
  -- (38) wall conductivity self-limits (2026-09-02, the constant
  -- kappa_wall = 1 fell to the overnight fill). References computed
  -- independently in Python (tools/assistant/claims/003-wall-kappa.md):
  -- n = 1e22, 800 K is neutral, 0.0177 (800/300)^0.7 = 0.0351683003;
  -- n = 1e22, 15000 K is alpha 0.9655, ln(Lambda) 4.98, kappa_e 1.019,
  -- mixture 0.99349970. A constant 1 W/m/K sink at 800 K fails this
  -- 28x. Both references at 1e-6 / 1e-3 rel.
  let kc38 = 1.0 * wall_kappa 1.0e22 0.0 800.0 0.0
  let ah38 = 1.0 * eos_alpha 1.0e22 15000.0
  let kh38 = 1.0 * wall_kappa 1.0e22 ah38 15000.0 0.0
  let ok38 = if fabs (kc38 / 0.0351683003 - 1.0) < 0.000001
             then fabs (kh38 / 0.99349970 - 1.0) < 0.001 else false
  let f38 = check "wall kappa self-limits (neutral 800 K, Spitzer 15 kK)" ok38 f37
  -- (39) pressure outlet + exit probe (2026-09-02). Three exit cells
  -- (column mp_nzm2) on a cold-ideal state (rho 2e-3 / p 2000 and
  -- rho 1e-3 / p 1000, both 4800 K, alpha ~1e-6): j=20 subsonic outflow
  -- vz 500 (c_s 1291), j=40 supersonic vz 5000, j=60 backflow vz -300.
  -- After one ghost fill the ghost column must read: j=20 rho and mz
  -- copied, p == amb_p; j=40 e_int copied (zero gradient); j=60 amb_rho
  -- at rest at amb_p; bt negated in all three. The probe must return the
  -- mass-flux-weighted Mach (m20 M20 + m40 M40)/(m20 + m40) with
  -- M = vz sqrt(3 rho / (5 p)), one backflow cell, min p over the column
  -- (the untouched 300 K prefill, fill_rho kT_m) and the fluid-cell count. The old zero-gradient ghost fails the
  -- subsonic and backflow branches. The Mach reference is the cold ideal
  -- value; the Saha inversion at 4800 K moves p by ~1e-4 (alpha ~1e-4 and
  -- the ionization share of e_int), hence 1e-3 rel there, exact elsewhere.
  let st39 = mv_init jt2
  let ie39 = 0 + mp_nzm2
  let ig39 = ie39 + 1
  let _ = mp_put st39 mp_f_rho 20 ie39 0.002
  let _ = mp_put st39 mp_f_mz 20 ie39 1.0
  let _ = mp_put st39 mp_f_en 20 ie39 (2000.0 / gamma_m1 + 0.5 * 1.0 * 500.0 + 0.5 * 0.01 * 0.01 * inv_mu0)
  let _ = mp_put st39 mp_f_rho 40 ie39 0.001
  let _ = mp_put st39 mp_f_mz 40 ie39 5.0
  let _ = mp_put st39 mp_f_en 40 ie39 (1000.0 / gamma_m1 + 0.5 * 5.0 * 5000.0 + 0.5 * 0.02 * 0.02 * inv_mu0)
  let _ = mp_put st39 mp_f_rho 60 ie39 0.002
  let _ = mp_put st39 mp_f_mz 60 ie39 (0.0 - 0.6)
  let _ = mp_put st39 mp_f_en 60 ie39 (2000.0 / gamma_m1 + 0.5 * 0.6 * 300.0 + 0.5 * 0.03 * 0.03 * inv_mu0)
  let _ = mp_put st39 mp_f_bt 20 ie39 0.01
  let _ = mp_put st39 mp_f_bt 40 ie39 0.02
  let _ = mp_put st39 mp_f_bt 60 ie39 0.03
  let _ = mv_apply_ghosts st39 btp m
  let pg20 = 1.0 * mv_pressure st39 20 ig39
  let ok39a = if mp_get st39 mp_f_rho 20 ig39 == 0.002
              then if mp_get st39 mp_f_mz 20 ig39 == 1.0
              then fabs (pg20 / amb_p - 1.0) < 0.000000001 else false else false
  let ef40 = 1.0 * mv_eint st39 40 ie39
  let eg40 = 1.0 * mv_eint st39 40 ig39
  let ok39b = if mp_get st39 mp_f_rho 40 ig39 == 0.001
              then if mp_get st39 mp_f_mz 40 ig39 == 5.0
              then fabs (eg40 / ef40 - 1.0) < 0.000000001 else false else false
  let pg60 = 1.0 * mv_pressure st39 60 ig39
  let ok39c = if mp_get st39 mp_f_rho 60 ig39 == amb_rho
              then if mp_get st39 mp_f_mz 60 ig39 == 0.0
              then fabs (pg60 / amb_p - 1.0) < 0.000000001 else false else false
  let okbt = if mp_get st39 mp_f_bt 20 ig39 == 0.0 - 0.01
             then if mp_get st39 mp_f_bt 40 ig39 == 0.0 - 0.02
             then mp_get st39 mp_f_bt 60 ig39 == 0.0 - 0.03 else false else false
  let ex39 = float_arr_new 5 0.0
  let _ = float_arr_set ex39 3 1.0e30
  let _ = mv_exit_probe st39 m ex39 1
  let m20 = 1.0 * mp_r_of 20
  let m40 = 1.0 * mp_r_of 40
  let mach20 = 500.0 * sqrt (3.0 * 0.002 / (5.0 * 2000.0))
  let mach40 = 5000.0 * sqrt (3.0 * 0.001 / (5.0 * 1000.0))
  let mexp = (1.0 * m20 * mach20 + 5.0 * m40 * mach40) / (1.0 * m20 + 5.0 * m40)
  let mgot = float_arr_get ex39 0 / float_arr_get ex39 1
  let okpr = if fabs (mgot / mexp - 1.0) < 0.001
             then if float_arr_get ex39 2 == 1.0
             then if float_arr_get ex39 4 == 128.0
             then fabs (float_arr_get ex39 3 / (fill_rho * kT_m) - 1.0) < 0.000000001
             else false else false else false
  let ok39 = if ok39a then if ok39b then if ok39c then if okbt then okpr else false else false else false else false
  let f39 = check "pressure outlet ghost (3 branches) + exit probe" ok39 f38
  -- (40) free-cathode ghosts (2026-09-03): with btp slot 0 = 1.0 the tip
  -- ghost copies the fluid B (dB/dz = 0), the barrel ghost carries
  -- B_f r_f / r_g (d(rB)/dr = 0), the corner takes the tip form; with
  -- slot 0 = 0.0 the prescribed 2 face - fluid still holds.
  let st40 = mv_init jt2
  let btp40 = mp_build_btp 8000.0
  let _ = mp_set_free_cath btp40 1.0
  let _ = mp_put st40 mp_f_bt 10 81 0.02
  let _ = mp_put st40 mp_f_bt 20 40 0.03
  let _ = mp_put st40 mp_f_bt 19 81 0.015
  let _ = mp_put st40 mp_f_bt 20 80 0.05
  let _ = mv_apply_ghosts st40 btp40 m
  let ratio40 = (to_float mp_j_fluid0 - 0.5) / (to_float mp_j_cath - 0.5)
  let ok40a = mp_get st40 mp_f_bt 10 80 == 0.02
  let ok40b = fabs (mp_get st40 mp_f_bt 19 40 / (0.03 * ratio40) - 1.0) < 0.000000000001
  let ok40c = mp_get st40 mp_f_bt 19 80 == 0.015
  let _ = mp_set_free_cath btp40 0.0
  let _ = mv_apply_ghosts st40 btp40 m
  let pres40 = 2.0 * float_arr_get btp40 (10 * mp_nz + 80) - 0.02
  let ok40d = fabs (mp_get st40 mp_f_bt 10 80 / pres40 - 1.0) < 0.000000000001
  let ok40 = if ok40a then if ok40b then if ok40c then ok40d else false else false else false
  let f40 = check "free-cathode ghosts: tip copy, barrel rB, corner, prescribed A/B" ok40 f39
  -- (41) free-cathode operator lock: the Neumann fold is EXACT on the
  -- zero-current field c/r (check 22 is only boundary-order through the
  -- Dirichlet fold; here the right face carries the exact ghost-mean so
  -- only the left fold is under test) and on a z-uniform field past the
  -- tip.
  let _ = st_line_rinv stx 40 20
  let _ = mv_rco stx scr2 dtbig 40 20 109 0
  let _ = mv_tri_neu_l scr2 ((to_float 20 - 0.5) / (to_float 20 - 1.5))
  let r128 = mp_r_of 128
  let r129 = mp_r_of 129
  let bdr = 0.5 * (0.001 / r128 + 0.001 / r129)
  let _ = mv_tri_dir_r scr2 109 bdr
  let _ = mv_thomas_fwd scr2 109 1
  let _ = mv_rback stx scr2 40 20 108 0.0
  let b70n = mp_get stx mp_f_bt 70 40
  let b20n = mp_get stx mp_f_bt 20 40
  let ok41a = fabs (b70n * r70 / 0.001 - 1.0) < 0.000000000001
  let ok41b = fabs (b20n * mp_r_of 20 / 0.001 - 1.0) < 0.000000000001
  let _ = st41_zfill stx 10 81
  let _ = mv_zco stx scr2 dtbig 10 81 24 0
  let _ = mv_tri_neu_l scr2 1.0
  let _ = mv_tri_dir_r scr2 24 0.002
  let _ = mv_thomas_fwd scr2 24 1
  let _ = mv_zback stx scr2 10 81 23 0.0
  let ok41c = fabs (mp_get stx mp_f_bt 10 81 / 0.002 - 1.0) < 0.000000000001
  let ok41d = fabs (mp_get stx mp_f_bt 10 95 / 0.002 - 1.0) < 0.000000000001
  let ok41 = if ok41a then if ok41b then if ok41c then ok41d else false else false else false
  let f41 = check "free-cathode Neumann fold exact on c/r and z-uniform" ok41 f40
  -- (42) pinching sums on the solver's pressure (2026-09-05): the tip
  -- row j = 1..19 at i = 81 set to the check-31 fully ionized state
  -- (rho 0.0019899, e_int 137877.86 -> Saha p = (1+alpha) n k T); the
  -- CT slot must be exactly p_saha * pi r_c^2 (the discrete tip area is
  -- exact) and the ideal-EOS legacy sum must overshoot it (2/3 e_int is
  -- ~2.5x the Saha p there), which is the defect this replaces.
  let st42 = mv_init jt2
  let _ = st42_fill st42 1
  let pg42 = mv_pressure_surfaces st42 m
  let ps42 = 1.0 * mv_pressure st42 10 81
  let area42 = pi_f * pbt_r_c * pbt_r_c
  let ok42a = fabs (float_arr_get pg42 1 / (ps42 * area42) - 1.0) < 0.000000001
  let pgi42 = sd_pressure_surfaces st42 m
  let ok42b = float_arr_get pgi42 1 > 2.0 * float_arr_get pg42 1
  let ok42 = if ok42a then ok42b else false
  let f42 = check "pinching sums on Saha p (tip = p_saha pi r_c^2; ideal 2x off)" ok42 f41
  -- (43) implicit magnetic-energy counter (2026-09-05): one z+r sweep
  -- pair on the 50-step state must book into scr_dme exactly the change
  -- of sum(B^2/2mu0 dV) over the fluid cells (the mv_diff_write pairing
  -- is exact per write, so the sum telescopes).
  let st43 = mv_init jt2
  let ns43 = mv_init jt2
  let fb43 = float_arr_new 42 0.0
  let scr43 = float_arr_new 55647 0.0
  let stw43 = mc_run st43 ns43 btp m fb43 scr43 0.0 50
  let _ = float_arr_set scr43 scr_dme 0.0
  let me43a = 1.0 * st43_me stw43 m 0 0.0
  let dt43 = 1.0 * mv_dt stw43 m
  let _ = mv_eta_loop stw43 scr43 0
  let _ = mv_zsweep stw43 btp m scr43 dt43 1
  let _ = mv_rsweep stw43 btp m scr43 dt43 1
  let me43b = 1.0 * st43_me stw43 m 0 0.0
  let dme43 = float_arr_get scr43 scr_dme
  let ok43 = fabs (dme43 / (me43b - me43a) - 1.0) < 0.000000001
  let f43 = check "implicit me counter books the sweeps' magnetic-energy change" ok43 f42
  -- (44) thrust target provenance (2026-09-05): the two fig-1 anchors
  -- the 8 kA target interpolates must be in the digitized data, and the
  -- interpolation must land at 24.0 N with sigma_dig ~0.9 N.
  let okp1 = find_pt dlines 7195.0 4.176
  let okp2 = find_pt dlines 8172.0 3.664
  let tm44 = 0.0 + thrust_meas_ar6_8ka
  let ts44 = 0.0 + thrust_meas_sigma_8ka
  let ok44 = if okp1 then if okp2 then if near tm44 24.03 0.03 then near ts44 0.88 0.05 else false else false else false
  let f44 = check "thrust target 24.0 +- 0.9 N from the fig-1 anchors" ok44 f43
  -- (45) exit face is choked upwind, no jump (2026-09-05). On the check-39
  -- state (ghosts applied, p cache filled): the subsonic cell j=20 (rho
  -- 2e-3, u 500, p 2000, c 1291) must carry the SONIC state, c* = (500 +
  -- 3 c)/4, rho* = rho (c*/c)^3, p* = p (c*/c)^5: S/2 = [rho* c*, 0,
  -- rho* c*^2 + p*, ...] and every gas jump d = 0; the supersonic cell
  -- j=40 must carry F(U_c) with d = 0; the backflow cell j=60 keeps the
  -- pair form (d[0] = amb_rho - rho_c). The boundary mass rate through
  -- the j=20 face must be rho* c* 2 pi r dr. Saha at 4800 K moves p by
  -- ~1e-4, hence 1e-3 rel on the state values, exact on the zeros.
  let _ = mv_parr_loop st39 scrq 0
  let _ = mv_face_z st39 scrq m fbq 20 ie39 10 30
  let c45 = sqrt (1.6666666666666667 * 2000.0 / 0.002)
  let cst45 = 0.25 * (500.0 + 3.0 * c45)
  let q45 = cst45 / c45
  let rst45 = 0.002 * q45 * q45 * q45
  let pst45 = 2000.0 * q45 * q45 * q45 * q45 * q45
  let ok45a = if fabs (0.5 * float_arr_get fbq 10 / (rst45 * cst45) - 1.0) < 0.001
              then fabs (0.5 * float_arr_get fbq 12 / (rst45 * cst45 * cst45 + pst45) - 1.0) < 0.001
              else false
  let ok45b = if float_arr_get fbq 30 == 0.0 then if float_arr_get fbq 32 == 0.0
              then float_arr_get fbq 33 == 0.0 else false else false
  let _ = mv_face_z st39 scrq m fbq 40 ie39 10 30
  let p40 = 1.0 * mv_pressure st39 40 ie39
  let ok45c = if fabs (0.5 * float_arr_get fbq 10 / 5.0 - 1.0) < 0.000000001
              then if fabs (0.5 * float_arr_get fbq 12 / (5.0 * 5000.0 + p40) - 1.0) < 0.001
              then float_arr_get fbq 33 == 0.0 else false else false
  let _ = mv_face_z st39 scrq m fbq 60 ie39 10 30
  let ok45d = fabs (float_arr_get fbq 30 / (amb_rho - 0.002) - 1.0) < 0.000000001
  let acc45 = float_arr_new 1 0.0
  let dt45 = 0.0 + 1.0e-9
  let _ = mv_bmass_face st39 m acc45 dt45 20 ie39 0 1
  let ok45e = fabs (float_arr_get acc45 0 / (0.0 - rst45 * cst45 * mv_tau * mp_r_of 20 * mp_dr) - 1.0) < 0.001
  let ok45 = if ok45a then if ok45b then if ok45c then if ok45d then ok45e else false else false else false else false
  let f45 = check "exit face: sonic state on subsonic cell, upwind supersonic, no jump" ok45 f44
  -- (46) solid faces carry no B and no energy in the hyperbolic step
  -- (2026-09-05). A moving gas (mr = mz = 0.5) with B = c/r everywhere,
  -- free cathode, ghosts applied: the barrel face (19|20, i=40), the
  -- chamber-wall face (128|129), the backplate face (j=60, 0|1), the tip
  -- face (j=10, 80|81) and the anode bore face (102|103, i=86) must all
  -- return S[3] = S[4] = d[3] = d[4] = 0 while the normal-momentum sum
  -- stays the pair form 2 (m_n^2/rho + p + (me_c + me_g)/2); the axis
  -- face (0|1, i=100, past the tip) must keep its nonzero bt jump (B is antisymmetric there,
  -- the true symmetry), and a fluid-fluid first-order face keeps its
  -- jumps.
  let st46 = mv_init jt2
  let _ = st46_fill st46 0
  let btp46 = mp_build_btp 8000.0
  let _ = mp_set_free_cath btp46 1.0
  let _ = mv_apply_ghosts st46 btp46 m
  let _ = mv_parr_loop st46 scrq 0
  let _ = mv_face_r st46 scrq m fbq 19 40 0 20
  let ok46a = st46_zero fbq
  let pw46 = 1.0 * mv_pressure st46 20 40
  let mec = 0.5 * mp_get st46 mp_f_bt 20 40 * mp_get st46 mp_f_bt 20 40 * inv_mu0
  let meg = 0.5 * mp_get st46 mp_f_bt 19 40 * mp_get st46 mp_f_bt 19 40 * inv_mu0
  let want46 = 2.0 * (0.25 / mp_get st46 mp_f_rho 20 40 + pw46) + mec + meg
  let ok46b = fabs (float_arr_get fbq 1 / want46 - 1.0) < 0.000000001
  let _ = mv_face_r st46 scrq m fbq 128 40 0 20
  let ok46c = st46_zero fbq
  let _ = mv_face_z st46 scrq m fbq 60 0 0 20
  let ok46d = st46_zero fbq
  let _ = mv_face_z st46 scrq m fbq 10 80 0 20
  let ok46e = st46_zero fbq
  let _ = mv_face_r st46 scrq m fbq 102 86 0 20
  let ok46f = st46_zero fbq
  let _ = mv_face_r st46 scrq m fbq 0 100 0 20
  let ok46g = fabs (float_arr_get fbq 24 / (2.0 * mp_get st46 mp_f_bt 1 100) - 1.0) < 0.000000001
  let _ = mv_face_r st46 scrq m fbq 20 40 0 20
  let ok46h = float_arr_get fbq 24 != 0.0
  let ok46 = if ok46a then if ok46b then if ok46c then if ok46d then if ok46e then if ok46f then if ok46g then ok46h
             else false else false else false else false else false else false else false
  let f46 = check "solid faces: no B / energy flux, wall force pair form kept, axis + fluid faces untouched" ok46 f45
  -- (47) corner faces are impermeable (2026-09-05). On the check-46
  -- state (moving gas, corner values loaded from btp46) the three corner
  -- faces must carry zero mass sum and zero mass / tangential-momentum /
  -- energy / bt jumps, the normal-momentum jump -2 m_n (a proper mirror),
  -- and mv_bmass_face must book 0 for them while a neighbouring
  -- non-corner solid face still books 0 too and the exit face does not.
  let _ = mv_load_corner btp46 scrq
  let _ = mv_face_r st46 scrq m fbq 19 80 0 20
  let ok47a = if float_arr_get fbq 0 == 0.0 then if float_arr_get fbq 20 == 0.0
              then if float_arr_get fbq 22 == 0.0 then if float_arr_get fbq 23 == 0.0
              then float_arr_get fbq 24 == 0.0 else false else false else false else false
  let ok47b = fabs (float_arr_get fbq 21 / (2.0 * mp_get st46 mp_f_mr 20 80) - 1.0) < 0.000000001
  let _ = mv_face_z st46 scrq m fbq 103 82 0 20
  let ok47c = if float_arr_get fbq 0 == 0.0 then if float_arr_get fbq 20 == 0.0
              then if float_arr_get fbq 21 == 0.0 then float_arr_get fbq 23 == 0.0 else false else false else false
  let ok47d = fabs (float_arr_get fbq 22 / (0.0 - 2.0 * mp_get st46 mp_f_mz 103 82) - 1.0) < 0.000000001
  let _ = mv_face_z st46 scrq m fbq 103 90 0 20
  let ok47e = if float_arr_get fbq 0 == 0.0 then if float_arr_get fbq 20 == 0.0
              then if float_arr_get fbq 21 == 0.0 then float_arr_get fbq 23 == 0.0 else false else false else false
  let ok47f = fabs (float_arr_get fbq 22 / (2.0 * mp_get st46 mp_f_mz 103 91) - 1.0) < 0.000000001
  let acc47 = float_arr_new 1 0.0
  let dt47 = 0.0 + 1.0e-9
  let _ = mv_bmass_face st46 m acc47 dt47 20 80 (0 - 1) 0
  let _ = mv_bmass_face st46 m acc47 dt47 103 82 0 1
  let _ = mv_bmass_face st46 m acc47 dt47 103 91 0 (0 - 1)
  let _ = mv_bmass_face st46 m acc47 dt47 20 40 (0 - 1) 0
  let ok47g = float_arr_get acc47 0 == 0.0
  let _ = mv_bmass_face st46 m acc47 dt47 60 104 0 1
  let ok47h = float_arr_get acc47 0 != 0.0
  let ok47 = if ok47a then if ok47b then if ok47c then if ok47d then if ok47e then if ok47f then if ok47g then ok47h
             else false else false else false else false else false else false else false
  let f47 = check "corner faces impermeable (three faces, proper mirrors, bmass 0)" ok47 f46
  -- (48) open radial boundary past the anode (2026-09-05). Mask: j=129
  -- is 4 up to the anode outer face (i <= 90) and 8 beyond. On a cold
  -- ideal state (rho 2e-3, p 2000, c 1291) with (128,95) radial outflow
  -- v_r 500 (subsonic), (128,100) v_r 5000, (128,103) v_r -300: the
  -- ghost column must mirror the exit rules (p amb_p / e_int copy /
  -- ambient at rest, bt negated); the (128|129, 95) face must carry the
  -- sonic state with zero gas jumps; mv_bmass_face must book
  -- -rho* c* 2 pi r_f dz there; the wall sink must remove NOTHING from a
  -- hot (128,95) and something from a hot (128,60) (the r = r_ch wall
  -- upstream of the anode; (128,85) is inside the anode ring).
  let ok48m = if mp_mask_of 129 95 == 8 then if mp_mask_of 129 85 == 4
              then if mp_mask_of 129 90 == 4 then mp_mask_of 129 91 == 8 else false else false else false
  let st48 = mv_init jt2
  let jf48 = 0 + mp_nrm2
  let jg48 = jf48 + 1
  let _ = mp_put st48 mp_f_rho jf48 95 0.002
  let _ = mp_put st48 mp_f_mr jf48 95 1.0
  let _ = mp_put st48 mp_f_en jf48 95 (2000.0 / gamma_m1 + 0.5 * 1.0 * 500.0 + 0.5 * 0.01 * 0.01 * inv_mu0)
  let _ = mp_put st48 mp_f_rho jf48 100 0.001
  let _ = mp_put st48 mp_f_mr jf48 100 5.0
  let _ = mp_put st48 mp_f_en jf48 100 (1000.0 / gamma_m1 + 0.5 * 5.0 * 5000.0 + 0.5 * 0.02 * 0.02 * inv_mu0)
  let _ = mp_put st48 mp_f_rho jf48 103 0.002
  let _ = mp_put st48 mp_f_mr jf48 103 (0.0 - 0.6)
  let _ = mp_put st48 mp_f_en jf48 103 (2000.0 / gamma_m1 + 0.5 * 0.6 * 300.0 + 0.5 * 0.03 * 0.03 * inv_mu0)
  let _ = mp_put st48 mp_f_bt jf48 95 0.01
  let _ = mp_put st48 mp_f_bt jf48 100 0.02
  let _ = mp_put st48 mp_f_bt jf48 103 0.03
  let _ = mv_apply_ghosts st48 btp m
  let pg95 = 1.0 * mv_pressure st48 jg48 95
  let ok48a = if mp_get st48 mp_f_rho jg48 95 == 0.002 then if mp_get st48 mp_f_mr jg48 95 == 1.0
              then fabs (pg95 / amb_p - 1.0) < 0.000000001 else false else false
  let ef100 = 1.0 * mv_eint st48 jf48 100
  let eg100 = 1.0 * mv_eint st48 jg48 100
  let ok48b = if mp_get st48 mp_f_mr jg48 100 == 5.0 then fabs (eg100 / ef100 - 1.0) < 0.000000001 else false
  let pg103 = 1.0 * mv_pressure st48 jg48 103
  let ok48c = if mp_get st48 mp_f_rho jg48 103 == amb_rho then if mp_get st48 mp_f_mr jg48 103 == 0.0
              then fabs (pg103 / amb_p - 1.0) < 0.000000001 else false else false
  let ok48d = if mp_get st48 mp_f_bt jg48 95 == 0.0 - 0.01 then mp_get st48 mp_f_bt jg48 103 == 0.0 - 0.03 else false
  let _ = mv_parr_loop st48 scrq 0
  let _ = mv_face_r st48 scrq m fbq jf48 95 0 20
  let ok48e = if fabs (0.5 * float_arr_get fbq 0 / (rst45 * cst45) - 1.0) < 0.001
              then fabs (0.5 * float_arr_get fbq 1 / (rst45 * cst45 * cst45 + pst45) - 1.0) < 0.001 else false
  let ok48f = if float_arr_get fbq 20 == 0.0 then if float_arr_get fbq 21 == 0.0
              then float_arr_get fbq 23 == 0.0 else false else false
  let acc48 = float_arr_new 1 0.0
  let _ = mv_bmass_face st48 m acc48 dt45 jf48 95 1 0
  let rf48 = 1.0 * mp_r_of jf48 + 0.5 * mp_dr
  let ok48g = fabs (float_arr_get acc48 0 / (0.0 - rst45 * cst45 * mv_tau * rf48 * mp_dz) - 1.0) < 0.001
  let sthot = mv_init jt2
  let _ = mp_put sthot mp_f_en jf48 95 (mp_get sthot mp_f_en jf48 95 + 8000.0)
  let _ = mp_put sthot mp_f_en jf48 60 (mp_get sthot mp_f_en jf48 60 + 8000.0)
  let e95a = mp_get sthot mp_f_en jf48 95
  let e85a = mp_get sthot mp_f_en jf48 60
  let fb48 = float_arr_new 42 0.0
  let _ = mv_wall_loop sthot m fb48 dt45 0
  let ok48h = if mp_get sthot mp_f_en jf48 95 == e95a then mp_get sthot mp_f_en jf48 60 < e85a else false
  let ok48 = if ok48m then if ok48a then if ok48b then if ok48c then if ok48d then if ok48e then if ok48f then if ok48g then ok48h
             else false else false else false else false else false else false else false else false
  let f48 = check "open radial boundary past the anode: mask, ghost, sonic face, bmass, no sink" ok48 f47
  -- (49) magnetised transport (2026-09-05): the Braginskii resistivity
  -- bracket is 1 at x = 0, 1.1274 at x = 1 and 1.9489 at x = 100
  -- (1.95 Drude/parallel); the thermal factor is 1 at x = 0 and 0.2682
  -- at x = 1; the cross-section table reads 0.3932 (x 1e-19) at 1 eV
  -- and 0.0816 at 0.3 eV (Ramsauer side); and the fully ionised
  -- check-31 cell, given a strong field (50 T, x ~ 145, en carrying the
  -- matching magnetic energy so e_int is unchanged), must read 1.95x its
  -- unmagnetised eta.
  let ok49a = if fabs (1.0 * eos_eta_perp_fac 0.0 - 1.0) < 0.000001
              then if fabs (1.0 * eos_eta_perp_fac 1.0 / 1.127353 - 1.0) < 0.0001
              then fabs (1.0 * eos_eta_perp_fac 100.0 / 1.948939 - 1.0) < 0.0001 else false else false
  let ok49b = if fabs (1.0 * eos_kappa_perp_fac 0.0 - 1.0) < 0.000001
              then fabs (1.0 * eos_kappa_perp_fac 1.0 / 0.268168 - 1.0) < 0.0001 else false
  let ok49c = if fabs (1.0 * eos_sig_en 1.0 / 3.9320 - 1.0) < 0.0001
              then fabs (1.0 * eos_sig_en 0.3 / 0.8160 - 1.0) < 0.0001 else false
  let _ = mp_put ste mp_f_bt 60 50 50.0
  let _ = mp_put ste mp_f_en 60 50 (137877.86303 + 0.5 * 50.0 * 50.0 * inv_mu0)
  let et49 = 1.0 * mv_eta_calc ste 60 50
  let x49 = 1.0 * eos_hall_x (0.0019899 / m_ion_ar) 1.0 50000.0 50.0
  let ok49d = if x49 > 100.0 then fabs (et49 / et31 / 1.950189 - 1.0) < 0.001 else false
  let ok49 = if ok49a then if ok49b then if ok49c then ok49d else false else false else false
  let f49 = check "magnetised transport: eta_perp(x), kappa_perp(x), sigma_en(T)" ok49 f48
  -- (50) free anode (2026-09-05): with btp slot 1 = 1.0 the bore ghost
  -- carries B_f r_f / r_g, the inner and outer face ghosts copy the
  -- fluid B; with 0.0 the prescribed 2 face - fluid holds. The Neumann
  -- RIGHT fold is exact (1e-12) on c/r for the r-line j = 20..102 at
  -- i = 86 (both ends Neumann: cathode barrel, anode bore) and on a
  -- z-uniform line j = 110, i = 1..82 ending at the inner face.
  let st50 = mv_init jt2
  let btp50 = mp_build_btp 8000.0
  let _ = mp_set_free_cath btp50 1.0
  let _ = mp_set_free_anode btp50 1.0
  let _ = mp_put st50 mp_f_bt 102 86 0.03
  let _ = mp_put st50 mp_f_bt 110 82 0.02
  let _ = mp_put st50 mp_f_bt 110 91 0.015
  let _ = mv_apply_ghosts st50 btp50 m
  let ratio50 = (to_float mp_j_anodem1 - 0.5) / (to_float mp_j_anode - 0.5)
  let ok50a = fabs (mp_get st50 mp_f_bt 103 86 / (0.03 * ratio50) - 1.0) < 0.000000000001
  let ok50b = if mp_get st50 mp_f_bt 110 83 == 0.02 then mp_get st50 mp_f_bt 110 90 == 0.015 else false
  let _ = mp_set_free_anode btp50 0.0
  let _ = mv_apply_ghosts st50 btp50 m
  let pres50 = 2.0 * float_arr_get btp50 (110 * mp_nz + 83) - 0.02
  let ok50c = fabs (mp_get st50 mp_f_bt 110 83 / pres50 - 1.0) < 0.000000000001
  -- both ends Neumann make (I - dt L) near-singular along c/r at dt = 1
  -- (1.5e-7 round-off there, 3e-10 at 1e-3); dt = 1e-6 keeps the fold under test and the
  -- solve well conditioned
  let dt50 = 0.0 + 0.000001
  let _ = st_line_rinv stx 86 20
  let _ = mv_rco stx scr2 dt50 86 20 83 0
  let _ = mv_tri_neu_l scr2 ((to_float 20 - 0.5) / (to_float 20 - 1.5))
  let _ = mv_tri_neu_r scr2 83 ((to_float 102 - 0.5) / (to_float 102 + 0.5))
  let _ = mv_thomas_fwd scr2 83 1
  let _ = mv_rback stx scr2 86 20 82 0.0
  let ok50d = if fabs (mp_get stx mp_f_bt 60 86 * mp_r_of 60 / 0.001 - 1.0) < 0.000000000001
              then fabs (mp_get stx mp_f_bt 102 86 * mp_r_of 102 / 0.001 - 1.0) < 0.000000000001 else false
  let _ = st50_zfill stx 110 1
  let _ = mv_zco stx scr2 dtbig 110 1 82 0
  let _ = mv_tri_dir_l scr2 0.002
  let _ = mv_tri_neu_r scr2 82 1.0
  let _ = mv_thomas_fwd scr2 82 1
  let _ = mv_zback stx scr2 110 1 81 0.0
  let ok50e = if fabs (mp_get stx mp_f_bt 110 40 / 0.002 - 1.0) < 0.000000000001
              then fabs (mp_get stx mp_f_bt 110 82 / 0.002 - 1.0) < 0.000000000001 else false
  let ok50 = if ok50a then if ok50b then if ok50c then if ok50d then ok50e else false else false else false else false
  let f50 = check "free anode: ghosts (bore rB, faces copy, prescribed A/B), Neumann right fold exact" ok50 f49
  if f50 == 0 then
    let _ = print "SELFTEST PASS (50 checks)"
    0
  else
    let _ = print (cat ["SELFTEST FAIL (", show f50, " of 50)"])
    1

-- check 50: uniform B = 0.002 along the z-line (j, i .. 82) up to the anode inner face
st50_zfill stx j i =
  if i > 82 then 0
  else
    let b = 0.002
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st50_zfill stx j (i + 1)

-- check 46: the four solid-face slots (S energy, S bt, d energy, d bt) are zero
st46_zero fb =
  if float_arr_get fb 3 == 0.0 then if float_arr_get fb 4 == 0.0
  then if float_arr_get fb 23 == 0.0 then float_arr_get fb 24 == 0.0
  else false else false else false

-- check 46: gas in motion with B = c/r on every cell (ghosts rebuilt after)
st46_fill stx ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let r = mp_r_of j
    let ra = if r < 0.0001 then 0.0001 else r
    let b = 0.001 / ra
    let rho = mp_get stx mp_f_rho j i
    let _ = mp_put stx mp_f_mr j i 0.5
    let _ = mp_put stx mp_f_mz j i 0.5
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (rho * kT_m / gamma_m1 + 0.25 / rho + 0.5 * b * b * inv_mu0)
    st46_fill stx (ji + 1)

-- check 42: fully ionized row on the cathode tip
st42_fill stx j =
  if j > mp_j_cath then 0
  else
    let bt = mp_get stx mp_f_bt j 81
    let _ = mp_put stx mp_f_rho j 81 0.0019899
    let _ = mp_put stx mp_f_en j 81 (137877.86303 + 0.5 * bt * bt * inv_mu0)
    st42_fill stx (j + 1)

-- check 43: sum of magnetic energy over fluid cells
st43_me stx m ji acc =
  if ji >= mp_nrnz then 1.0 * acc
  else
    let v = if arr_get m ji == 0 then
        let b = float_arr_get stx (4 * mp_nrnz + ji)
        0.5 * b * b * inv_mu0 * mv_tau * mp_r_of (ji / mp_nz) * mp_dr * mp_dz
      else 0.0
    st43_me stx m (ji + 1) (acc + v)

-- check 44: a digitized point near (j, ct)
find_pt lines j0 ct0 =
  if lines == [] then false
  else
    let line = head lines
    if line == "" then find_pt (tail lines) j0 ct0
    else
      let f = split "," line
      let j = parse_float (nth 0 f)
      let ct = parse_float (nth 1 f)
      let hit1 = if near j j0 1.0 then near ct ct0 0.001 else false
      if hit1 then true else find_pt (tail lines) j0 ct0

-- uniform B = 0.002 along the z-line (j, i .. mp_nzm2) past the tip
st41_zfill stx j i =
  if i > mp_nzm2 then 0
  else
    let b = 0.002
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st41_zfill stx j (i + 1)

st37_fill stx c ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let _ = mp_put stx mp_f_bt j i (c * mp_r_of j)
    st37_fill stx c (ji + 1)

st37_eta scr eta ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set scr (scr_eta + ji) eta
    st37_eta scr eta (ji + 1)

st37_vol m ji acc =
  if ji >= mp_nrnz then 1.0 * acc
  else
    let v = if arr_get m ji == 0 then mv_tau * mp_r_of (ji / mp_nz) * mp_dr * mp_dz else 0.0
    st37_vol m (ji + 1) (acc + v)

mc_run st ns btp m fb scr unused n =
  if n <= 0 then st
  else
    let dt = 1.0 * mv_dt st m
    let _ = mv_step st ns btp m fb scr dt
    mc_run ns st btp m fb scr unused (n - 1)

-- line fills for the implicit-diffusion guards: set bt and rebuild en so
-- p stays exactly amb_p (mv_init leaves momenta zero and p uniform)
st_line_rinv stx i j =
  if j > mp_nrm2 then 0
  else
    let r = mp_r_of j
    let b = 0.001 / r
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_rinv stx i (j + 1)

st_line_zlin stx j i =
  if i > mp_nzm2 then 0
  else
    let z = mp_z_of i
    let b = 0.001 + 0.01 * z
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_zlin stx j (i + 1)

st_line_alr stx i j =
  if j > mp_nrm2 then 0
  else
    let r = mp_r_of j
    let b = 0.01 * r
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_alr stx i (j + 1)

-- analytic smooth field / decaying coax fills (phase2_identity mirrors)
st_fill_an bt jtot i =
  if i >= mp_nrnz then 0
  else
    let j = i / mp_nz
    let z = i % mp_nz
    let r = mp_r_of j
    let v = mu0_2pi * jtot * (r / (pbt_r_ch * pbt_r_ch)) * (1.0 - mp_z_of z / 0.13)
    let _ = float_arr_set bt i v
    st_fill_an bt jtot (i + 1)

st_fill_dec bt jtot i =
  if i >= mp_nrnz then 0
  else
    let j = i / mp_nz
    let z = i % mp_nz
    let r = mp_r_of j
    let ra = if r < 0.001 then 0.001 else r
    let g = 1.0 - mp_z_of z / 0.13
    let _ = float_arr_set bt i (mu0_2pi * jtot * g / ra)
    st_fill_dec bt jtot (i + 1)
