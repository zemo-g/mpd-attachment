-- rail/selftest.rail -- Phase 0/1 guards. Prints SELFTEST PASS or SELFTEST FAIL.
-- Do not rely on the exit code (rail_native run historically swallowed it);
-- callers grep the last line.
--
-- Guards:
--   transcription of the Table 2 fits (spot values cross-checked against the
--   JPP-2001 scatter plots by eye, tolerance covers the readout)
--   the I_fi = J_ci coincidence check case from the program doc
--   digitized fig-1 anchor points
--   scoreboard output sanity

import "rail/pbt.rail"
import "rail/semi_lib.rail"
import "rail/mhd_pbt.rail"
import "rail/stress_diag.rail"
import "rail/mpd_solver.rail"

run_hall = 0.0

near v target tol = fabs (v - target) < tol

-- set the near-inlet fluid row to a given density (selftest 33)
st_set_inrow stx mm v j =
  if j >= mp_nr then 0.0
  else
    let _ = if arr_get mm (j * mp_nz) == 6 then mp_put stx mp_f_rho j 1 v
            else 0.0
    st_set_inrow stx mm v (j + 1)

check name ok fails =
  if ok then fails
  else
    let _ = print (cat ["  FAIL: ", name])
    fails + 1

-- count scoreboard rows and range-check C_T
scan_rows lines n bad =
  if lines == [] then [n, bad]
  else
    let line = head lines
    let rest = tail lines
    if line == "" then scan_rows rest n bad
    else
      let f = split "," line
      let ct = parse_float (nth 4 f)
      let sg = parse_float (nth 5 f)
      let ok1 = if ct > 1.5 then ct < 8.0 else false
      let ok = if ok1 then sg > 0.0 else false
      scan_rows rest (n + 1) (if ok then bad else bad + 1)

-- find a digitized 3 g/s point near (3238, 6.857)
find_anchor lines =
  if lines == [] then false
  else
    let line = head lines
    if line == "" then find_anchor (tail lines)
    else
      let f = split "," line
      let j = parse_float (nth 0 f)
      let ct = parse_float (nth 1 f)
      let hit1 = if near j 3238.0 60.0 then near ct 6.857 0.15 else false
      if hit1 then true else find_anchor (tail lines)

main =
  let f0 = 0
  -- geometry-derived constants
  let f1 = check "maecker C_T = 2.4305" (near maecker_ct 2.4305 0.001) f0
  -- program-doc check case: I_fi(argon, 660 mg/s, b=1.8e-7) ~ 5600 A,
  -- same quantity as J_ci
  let ifi = sqrt (0.00066 * uci_argon / 1.8e-7)
  let f2 = check "I_fi check case ~5600 A" (near ifi 5600.0 100.0) f1
  -- Table 2 transcription spot checks (values also validated against scatter)
  let f3 = check "fit Ar1 T(6500)" (near (fit_t_ar1 6500.0) 8.2 0.6) f2
  let f4 = check "fit Ar3 T(15000)" (near (fit_t_ar3 15000.0) 44.4 1.5) f3
  let f5 = check "fit Ar6 T(20000)" (near (fit_t_ar6 20000.0) 82.8 1.5) f4
  let f6 = check "fit Xe3 T(10000)" (near (fit_t_xe3 10000.0) 20.9 1.0) f5
  let f7 = check "fit Xe6 T(20000)" (near (fit_t_xe6 20000.0) 82.0 2.0) f6
  -- Xe6 a5 exponent regression guard (e-14 turns T(7500) negative)
  let f8 = check "fit Xe6 T(7500) positive" (fit_t_xe6 7500.0 > 10.0) f7
  -- xi relation: xi^2 INSIDE the log (outside gives 2.77 at xi=1, 6 g/s)
  let f9 = check "choueiri_ct(6 g/s, xi=1) in 1.85..2.00"
             (near (choueiri_ct 6.0 1.0) 1.925 0.075) f8
  -- digitized data anchors
  let raw = read_file "data/fig1_points.csv"
  let dlines = tail (split "\n" raw)
  let f10 = check "fig1 anchor (3238, 6.857)" (find_anchor dlines) f9
  -- scoreboard sanity
  let sraw = read_file "out/measured_ct.csv"
  let slines = tail (split "\n" sraw)
  let nb = scan_rows slines 0 0
  let f11 = check "scoreboard >= 240 rows" (nth 0 nb >= 240) f10
  let f12 = check "scoreboard C_T in (1.5, 8), sigma > 0" (nth 1 nb == 0) f11
  -- semi-empirical model guards
  -- eq 22 parabolic-profile identity: mean-pressure form == direct a,b form
  let bp1 = tp_bp 1500.0 700.0
  let bp2 = tp_bp_direct 1500.0 700.0
  let f13 = check "tp_bp identity (mean-pressure == a,b form)"
              (fabs (bp1 - bp2) < 0.0000001) f12
  -- backplate blowing in C_T units is exactly ln(r_ch/r_c)
  let v16k = tb_bp 16000.0
  let f14 = check "BP blowing C_T = ln(rch/rc)"
              (near (v16k / (mu0_4pi * 256000000.0)) 1.90759 0.0001) f13
  -- eq 23 ln variant lock: with ln(ra/rch), inferred p_rc tracks Cory's
  -- p_rch in the 12-16 kA band (the printed ln(ra/rc) goes NEGATIVE there)
  let t12 = fit_t_ar6 12000.0
  let t16 = fit_t_ar6 16000.0
  let p12 = infer_p_rc t12 12000.0 ln_ch
  let p16 = infer_p_rc t16 16000.0 ln_ch
  let c12 = cory_p_rch 12000.0
  let c16 = cory_p_rch 16000.0
  -- 1.0 * forces float typing of the user-fn results (marker quirk)
  let r12 = 1.0 * p12 / c12
  let r16 = 1.0 * p16 / c16
  let ok12 = if r12 > 0.7 then r12 < 1.3 else false
  let ok16 = if r16 > 0.7 then r16 < 1.3 else false
  let f15 = check "p_rc(lnch) tracks Cory at 12 kA" ok12 f14
  let f16 = check "p_rc(lnch) tracks Cory at 16 kA" ok16 f15
  -- flat backplate profile cannot reproduce the low-current rise:
  -- at 7195 A (fig1 point, measured C_T 4.18) flat lands below 3.0
  let rest7 = t_rest 7195.0 ln_ch
  let flat7 = tp_bp (cory_p_rch 7195.0) (cory_p_rch 7195.0)
  let ctf7 = (rest7 + flat7) / (mu0_4pi * 7195.0 * 7195.0)
  let f17 = check "flat profile misses low-current rise" (ctf7 < 3.0) f16
  -- phase 2 layer-0 guards: stress-identity machinery on the PBT grid
  let m = mp_build_mask
  let bt1 = float_arr_new mp_nrnz 0.0
  let _ = st_fill_an bt1 8000.0 0
  let tv = 1.0 * sd_volume_integral bt1 m
  let sg1 = sd_surface_integral bt1 m
  let ts = float_arr_get sg1 0 + float_arr_get sg1 1 + float_arr_get sg1 2 + float_arr_get sg1 3 + float_arr_get sg1 4
  let f18 = check "stress identity (analytic field) < 1e-6"
              (fabs (tv / ts - 1.0) < 0.000001) f17
  let btp = mp_build_btp 8000.0
  let bt3 = float_arr_new mp_nrnz 0.0
  let _ = st_fill_dec bt3 8000.0 0
  let _ = sd_fill_ghosts bt3 btp m
  let sg3 = sd_surface_integral bt3 m
  let bp_ref = mu0_4pi * log (pbt_r_ch / pbt_r_c) * 64000000.0
  let aif_ref = tb_aif 8000.0
  let f19 = check "surface BP matches eq 13 (1e-3)"
              (fabs (float_arr_get sg3 0 / bp_ref - 1.0) < 0.001) f18
  let f20 = check "surface AIF matches eq 14 (1%)"
              (fabs (float_arr_get sg3 2 / aif_ref - 1.0) < 0.01) f19
  -- the prescription-as-constant compiler-bug guard: tip btp must be sane
  let tipv = 1.0 * float_arr_get btp (19 * mp_nz + 80)
  let f21 = check "tip prescription sane (compiler-bug guard)"
              (near tipv 0.0328 0.001) f20
  -- implicit-diffusion guards: the Thomas solve must preserve the exact
  -- steady profiles of each 1D operator (any eta field for c/r since its
  -- flux g = (1/r) d(rB)/dr is identically zero; uniform eta for the
  -- others -- mv_init gives uniform p and rho, so the line fills rebuild
  -- en to keep p = amb_p exactly)
  let jt2 = 0.0 + 8000.0
  let stx = mv_init jt2
  let scr2 = float_arr_new 55641 0.0
  -- mv_rco/mv_zco read eta from the scr cache since the 2026-09-01
  -- caching pass: fill it or the operators run with eta = 0 and checks
  -- 23-25 pass VACUOUSLY (nothing diffuses, profiles trivially held).
  -- One fill is exact here: the st_line_* fills keep e_int uniform.
  let _ = mv_eta_loop stx scr2 0
  let dtbig = 1.0
  -- (22) r-solve, coax vacuum field c/r on j = 20..128 at i = 40
  let _ = st_line_rinv stx 40 20
  let _ = mv_rco stx scr2 dtbig 40 20 109 0
  let _ = mv_tri_dir_l scr2 (0.001 / pbt_r_c)
  let _ = mv_tri_dir_r scr2 109 (0.001 / pbt_r_ch)
  let _ = mv_thomas_fwd scr2 109 1
  let _ = mv_rback stx scr2 40 20 108 0.0
  -- c/r has curvature, and the ghost fold is linear extrapolation, so
  -- preservation here is boundary-order (O(dr^2/r^2) at the cathode
  -- face), not exact -- the tolerance reflects that
  let b70 = mp_get stx mp_f_bt 70 40
  let r70 = mp_r_of 70
  let f22 = check "implicit r-solve holds c/r to boundary order"
              (fabs (b70 * r70 / 0.001 - 1.0) < 0.005) f21
  -- (23) z-solve, linear profile on i = 1..104 at j = 60
  let _ = st_line_zlin stx 60 1
  let _ = mv_zco stx scr2 dtbig 60 1 104 0
  let _ = mv_tri_dir_l scr2 0.001
  let _ = mv_tri_dir_r scr2 104 0.0023
  let _ = mv_thomas_fwd scr2 104 1
  let _ = mv_zback stx scr2 60 1 103 0.0
  let b52 = mp_get stx mp_f_bt 60 52
  let z52 = mp_z_of 52
  let f23 = check "implicit z-solve preserves linear profile"
              (fabs (b52 / (0.001 + 0.01 * z52) - 1.0) < 0.000000001) f22
  -- (24) axis regularization, B = alpha r on j = 1..128 at i = 100
  let _ = st_line_alr stx 100 1
  let _ = mv_rco stx scr2 dtbig 100 1 128 0
  let _ = mv_tri_dir_r scr2 128 (0.01 * pbt_r_ch)
  let _ = mv_thomas_fwd scr2 128 1
  let _ = mv_rback stx scr2 100 1 127 0.0
  let b64 = mp_get stx mp_f_bt 64 100
  let r64 = mp_r_of 64
  let f24 = check "implicit axis solve preserves B ~ r"
              (fabs (b64 / (0.01 * r64) - 1.0) < 0.000000001) f23
  -- (25) B = alpha r again but through BOTH Dirichlet folds (j = 20..128
  -- at i = 40; linear extrapolation is exact on a linear profile, so this
  -- one IS exact): locks the fold-in coefficients
  let _ = st_line_alr stx 40 1
  let _ = mv_rco stx scr2 dtbig 40 20 109 0
  let _ = mv_tri_dir_l scr2 (0.01 * pbt_r_c)
  let _ = mv_tri_dir_r scr2 109 (0.01 * pbt_r_ch)
  let _ = mv_thomas_fwd scr2 109 1
  let _ = mv_rback stx scr2 40 20 108 0.0
  let b90 = mp_get stx mp_f_bt 90 40
  let r90 = mp_r_of 90
  let f25 = check "implicit r-solve exact on B ~ r through both folds"
              (fabs (b90 / (0.01 * r90) - 1.0) < 0.000000001) f24
  -- (26) mass-conservation gate: the interior creates NOTHING. After 50
  -- real solver steps from cold init, one more step's change in total
  -- mass must equal dt * (boundary flux rate) - the defect this guards
  -- against manufactured ~7e-3 kg/s on the pre-conservative scheme
  -- (2026-08-31). The floor accumulator must also stay 0.
  -- mc_run recomputes dt EVERY step (the partially-ionized eta makes the
  -- cold-start ignition transient violent enough that a frozen dt
  -- detonates within 50 steps; the real runner adapts dt too). The gate
  -- itself is unchanged: one measured step, dm == dt * boundary rate,
  -- and the floor must not fire DURING that step.
  let stq = mv_init jt2
  let nsq0 = mv_init jt2
  let fbq = float_arr_new 42 0.0
  let scrq = float_arr_new 55641 0.0
  let stw = mc_run stq nsq0 btp m fbq scrq 0.0 50
  let _ = mv_apply_ghosts stw btp m
  let dtq = 1.0 * mv_dt stw m
  let m0 = 1.0 * mv_total_mass stw m
  let br = 1.0 * mv_bmass_rate stw m dtq
  let fm0 = float_arr_get scrq scr_fmass
  let nsw = float_arr_new mp_state 0.0
  let _ = mv_step stw nsw btp m fbq scrq dtq
  let m1 = 1.0 * mv_total_mass nsw m
  let dm = m1 - m0
  let pred = dtq * br
  let okm = fabs (dm - pred) < fabs pred * 0.000001 + 1.0e-18
  let ok26 = if okm then float_arr_get scrq scr_fmass == fm0 else false
  let f26 = check "one-step mass conservation (interior creates nothing)" ok26 f25
  -- (27..29) Saha EOS guards (2026-09-01). References computed
  -- independently in Python from CODATA constants (chi = 15.759611 eV,
  -- U_i/U_0 = 6); see the eos_* block in mpd_solver.rail.
  -- (27) cold limit is EXACTLY the ideal gas (no exp paid, no drift)
  let nref = 0.0 + 3.0e22
  let ec27 = 1.5 * nref * k_boltz * 400.0
  let t27 = 1.0 * eos_temp nref ec27
  let f27 = check "EOS cold limit exact (T=400)"
              (fabs (t27 / 400.0 - 1.0) < 0.000000000001) f26
  -- (28) Saha alpha spot value in the band
  let a28 = 1.0 * eos_alpha nref 12000.0
  let f28 = check "Saha alpha(3e22, 12000 K) = 0.4206663"
              (near a28 0.4206663108 0.000001) f27
  -- (29) inversion round-trip through the steep band: T -> e_int -> T
  let e29 = 1.0 * eos_e nref 15000.0
  let t29 = 1.0 * eos_temp nref e29
  let f29 = check "EOS round-trip at T=15000"
              (fabs (t29 / 15000.0 - 1.0) < 0.00001) f28
  -- (30..31) partially-ionized eta (Python refs from the same constants:
  -- n = 3e22, sigma_en = 1e-19). 30: weakly ionized band, e-n dominated.
  -- 31: fully ionized limit collapses to pure Spitzer.
  let ste = mv_init jt2
  let _ = mp_put ste mp_f_rho 60 50 0.0019899
  let _ = mp_put ste mp_f_bt 60 50 0.0
  let _ = mp_put ste mp_f_en 60 50 8399.1649143
  let et30 = 1.0 * mv_eta_calc ste 60 50
  -- References re-derived 2026-09-01 late for the Coulomb logarithm
  -- (NRL ln(Lambda) = 23 - ln(sqrt(n_e[cm^-3]) / T_eV^1.5)): at n =
  -- 3e22, T = 9000 K alpha = 0.03452, ln(Lambda) = 5.332, eta_ei =
  -- 4.0594e-4 + eta_en 5.8503e-5; at T = 50000 K (alpha = 1)
  -- ln(Lambda) = 6.221, eta = 3.6170e-5. The old 1.317e-4 / 5.59e-6
  -- were the ln(Lambda) = 0.96 coefficient (claim 001a).
  let f30 = check "eta partially-ionized (T=9000) = 4.644e-4"
              (fabs (et30 / 0.00046444552224 - 1.0) < 0.001) f29
  let _ = mp_put ste mp_f_en 60 50 137877.86303
  let et31 = 1.0 * mv_eta_calc ste 60 50
  let f31 = check "eta fully-ionized limit = Spitzer lnL 6.22: 3.617e-5"
              (fabs (et31 / 0.000036169828934 - 1.0) < 0.001) f30
  -- (32..33) inlet guards (2026-09-01). History: the metered ghost's
  -- velocity cap engaged on the reflected MOMENTUM and silently clipped
  -- 19 of 29 inlet rows for three segments; gating it on near-vacuum
  -- fluid then engaged anyway in every second-order segment (half the
  -- rows at 5% of nominal, mdot_in 6.0e-3 -> 2.87e-3), because the
  -- less-diffusive scheme evacuates the near-inlet gas. The inlet is
  -- now a PRESCRIBED-FLUX face (mv_face_zin): 32 holds the counter
  -- exact at operating density; 33 holds the face the scheme actually
  -- consumes exact on a VACUUM inlet cell (S = 2 rho_in v_in, jump 0),
  -- and the counter agreeing. 0.00599999578365988 is the geometric
  -- nominal: the inlet area sum is discretized, so it is not exactly
  -- 0.006 and must not be "fixed" to it.
  let sti = mv_init jt2
  let _ = mv_apply_ghosts sti btp m
  let dti = 1.0 * mv_dt sti m
  let ri = 1.0 * mv_inlet_rate sti m dti
  let f32 = check "metered inlet exact at operating density"
              (fabs (ri / 0.00599999578365988 - 1.0) < 0.000001) f31
  -- drop the near-inlet gas to 1e-5 kg/m^3 (50x below the old vacuum
  -- gate): the prescribed face must still deliver exactly nominal
  let vac = 0.0 + 0.00001
  let _ = st_set_inrow sti m vac 0
  let _ = mv_apply_ghosts sti btp m
  let _ = mv_parr_loop sti scrq 0
  let _ = mv_face_z sti scrq m fbq 25 0 15 35
  let s33 = float_arr_get fbq 15
  let d33 = float_arr_get fbq 35
  let rv = 1.0 * mv_inlet_rate sti m dti
  let f33 = check "prescribed inlet face exact on vacuum cell"
              (if fabs (s33 / 8.8242 - 1.0) < 0.000000000001
               then if d33 == 0.0
               then fabs (rv / 0.00599999578365988 - 1.0) < 0.000001
               else false else false) f32
  -- (34..35) MUSCL reconstruction guards (2026-09-01 second-order
  -- upgrade). 34: on linear data the face states are EXACT midpoints
  -- from both sides (second order in smooth regions). 35: at an
  -- extremum minmod clips the slope to zero, reverting to first order
  -- (TVD; no new extrema). Both are the properties the scheme's
  -- stability and its selftest-26 telescoping rest on.
  let l34a = 1.0 * mv_recl 1.0 3.0 5.0
  let r34a = 1.0 * mv_recr 3.0 5.0 7.0
  let f34 = check "minmod faces exact on linear data"
              (if fabs (l34a - 4.0) < 0.000000000001
               then fabs (r34a - 4.0) < 0.000000000001 else false) f33
  let l35a = 1.0 * mv_recl 1.0 5.0 3.0
  let r35a = 1.0 * mv_recr 5.0 1.0 3.0
  let f35 = check "minmod clips at extrema (first order)"
              (if fabs (l35a - 5.0) < 0.000000000001
               then fabs (r35a - 1.0) < 0.000000000001 else false) f34
  -- (36) wall sink: one application on a single hot cell adjacent to
  -- the cathode (j=20, i=40; only its r- face touches solid) must
  -- remove EXACTLY kappa_wall (T - t_wall) dt G with G = 2 r_f- /
  -- (r dr^2), leave total mass untouched, and book the same Joules
  -- (dE * cell volume) into the fb counter slot.
  let st36 = mv_init jt2
  let en0v = mp_get st36 mp_f_en 20 40
  let ei0 = 1.0 * mv_eint st36 20 40
  let eit = 0.0 + 8399.1649143
  let _ = mp_put st36 mp_f_en 20 40 (en0v - ei0 + eit)
  let m36a = 1.0 * mv_total_mass st36 m
  let fb36 = float_arr_new 42 0.0
  let dt36 = 0.0 + 1.0e-9
  let _ = mv_wall_loop st36 m fb36 dt36 0
  let m36b = 1.0 * mv_total_mass st36 m
  let rho36 = mp_get st36 mp_f_rho 20 40
  let t36 = 1.0 * eos_temp (rho36 / m_ion_ar) eit
  let r36 = 1.0 * mp_r_of 20
  let g36 = 2.0 * (r36 - 0.5 * mp_dr) / (r36 * mp_dr * mp_dr)
  let de36 = kappa_wall * (t36 - t_wall) * dt36 * g36
  let got36 = eit - 1.0 * mv_eint st36 20 40
  let okde = fabs (got36 / de36 - 1.0) < 0.000000001
  let okm36 = m36b == m36a
  let vol36 = mv_tau * r36 * mp_dr * mp_dz
  let okfb = fabs (float_arr_get fb36 40 / (de36 * vol36) - 1.0) < 0.000000001
  let ok36 = if okde then if okm36 then okfb else false else false
  let f36 = check "wall sink analytic rate, mass untouched" ok36 f35
  -- (37) Ohmic counter: with bt = c r everywhere (including ghosts) the
  -- discrete jz is exactly 2 c / mu0 in every cell and jr = 0, so with a
  -- uniform eta cache one mv_heat_loop must book dt eta jz^2 V_fluid
  -- Joules into fb slot 41, where V_fluid is summed independently of
  -- the current stencil. It also must raise en by dt eta jz^2 per cell.
  let st37 = mv_init jt2
  let c37 = 0.0 + 0.5
  let _ = st37_fill st37 c37 0
  let scr37 = float_arr_new 55641 0.0
  let eta37 = 0.0 + 0.0001
  let _ = st37_eta scr37 eta37 0
  let fb37 = float_arr_new 42 0.0
  let dt37 = 0.0 + 1.0e-9
  let en37a = mp_get st37 mp_f_en 20 40
  let _ = mv_heat_loop st37 m scr37 fb37 dt37 0
  let en37b = mp_get st37 mp_f_en 20 40
  let jz37 = 2.0 * c37 * inv_mu0
  let vf37 = 1.0 * st37_vol m 0 0.0
  let want37 = dt37 * eta37 * jz37 * jz37 * vf37
  let okfb37 = fabs (float_arr_get fb37 41 / want37 - 1.0) < 0.000000001
  let oken37 = fabs ((en37b - en37a) / (dt37 * eta37 * jz37 * jz37) - 1.0) < 0.000000001
  let ok37 = if okfb37 then oken37 else false
  let f37 = check "Ohmic counter books dt eta j^2 V_fluid" ok37 f36
  if f37 == 0 then
    let _ = print "SELFTEST PASS (37 checks)"
    0
  else
    let _ = print (cat ["SELFTEST FAIL (", show f37, " of 37)"])
    1

st37_fill stx c ji =
  if ji >= mp_nrnz then 0
  else
    let j = ji / mp_nz
    let i = ji % mp_nz
    let _ = mp_put stx mp_f_bt j i (c * mp_r_of j)
    st37_fill stx c (ji + 1)

st37_eta scr eta ji =
  if ji >= mp_nrnz then 0
  else
    let _ = float_arr_set scr (scr_eta + ji) eta
    st37_eta scr eta (ji + 1)

st37_vol m ji acc =
  if ji >= mp_nrnz then 1.0 * acc
  else
    let v = if arr_get m ji == 0 then mv_tau * mp_r_of (ji / mp_nz) * mp_dr * mp_dz else 0.0
    st37_vol m (ji + 1) (acc + v)

mc_run st ns btp m fb scr unused n =
  if n <= 0 then st
  else
    let dt = 1.0 * mv_dt st m
    let _ = mv_step st ns btp m fb scr dt
    mc_run ns st btp m fb scr unused (n - 1)

-- line fills for the implicit-diffusion guards: set bt and rebuild en so
-- p stays exactly amb_p (mv_init leaves momenta zero and p uniform)
st_line_rinv stx i j =
  if j > mp_nrm2 then 0
  else
    let r = mp_r_of j
    let b = 0.001 / r
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_rinv stx i (j + 1)

st_line_zlin stx j i =
  if i > mp_nzm2 then 0
  else
    let z = mp_z_of i
    let b = 0.001 + 0.01 * z
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_zlin stx j (i + 1)

st_line_alr stx i j =
  if j > mp_nrm2 then 0
  else
    let r = mp_r_of j
    let b = 0.01 * r
    let _ = mp_put stx mp_f_bt j i b
    let _ = mp_put stx mp_f_en j i (amb_p / gamma_m1 + 0.5 * b * b * inv_mu0)
    st_line_alr stx i (j + 1)

-- analytic smooth field / decaying coax fills (phase2_identity mirrors)
st_fill_an bt jtot i =
  if i >= mp_nrnz then 0
  else
    let j = i / mp_nz
    let z = i % mp_nz
    let r = mp_r_of j
    let v = mu0_2pi * jtot * (r / (pbt_r_ch * pbt_r_ch)) * (1.0 - mp_z_of z / 0.13)
    let _ = float_arr_set bt i v
    st_fill_an bt jtot (i + 1)

st_fill_dec bt jtot i =
  if i >= mp_nrnz then 0
  else
    let j = i / mp_nz
    let z = i % mp_nz
    let r = mp_r_of j
    let ra = if r < 0.001 then 0.001 else r
    let g = 1.0 - mp_z_of z / 0.13
    let _ = float_arr_set bt i (mu0_2pi * jtot * g / ra)
    st_fill_dec bt jtot (i + 1)
