-- rail/phase1_baselines.rail -- Phase 1: the bar to beat.
-- Maecker (baseline 1) and the Choueiri xi relation (baseline 2) evaluated
-- against the Phase 0 scoreboard. Emits out/phase1_residuals.csv and prints
-- per-series stats. Also checks the doc's low-current claim: C_T ~ J^-n,
-- n in 3..4, on the digitized fig-1 points below xi = 0.6.
--
-- Run from repo root AFTER phase0: rail_native run rail/phase1_baselines.rail

import "rail/pbt.rail"

in_path = "out/measured_ct.csv"
out_path = "out/phase1_residuals.csv"

-- groups: 0..4 = jpp2001 fits (Ar1 Ar3 Ar6 Xe3 Xe6), 5 = fig1 Ar3, 6 = fig1 Ar6
n_groups = 7

group_name g =
  if g == 0 then "fit Ar 1 g/s"
  else if g == 1 then "fit Ar 3 g/s"
  else if g == 2 then "fit Ar 6 g/s"
  else if g == 3 then "fit Xe 3 g/s"
  else if g == 4 then "fit Xe 6 g/s"
  else if g == 5 then "fig1 Ar 3 g/s"
  else "fig1 Ar 6 g/s"

group_of src prop mdot =
  if src == "jpp2001_fit" then
    if prop == "argon" then
      if mdot < 2.0 then 0
      else if mdot < 4.0 then 1
      else 2
    else
      if mdot < 4.0 then 3 else 4
  else
    if mdot < 4.0 then 5 else 6

-- accumulator layout, per group g at base g*12:
--   0 n | 1 sum rm^2 | 2 sum rx^2 | 3 max|rm| | 4 max|rx| | 5 sum z
--   6 nlo | 7 Sx | 8 Sy | 9 Sxy | 10 Sxx   (low-current slope, xi<0.6)
acc_bump a base off v =
  let cur = float_arr_get a (base + off)
  float_arr_set a (base + off) (cur + v)

acc_max a base off v =
  let cur = float_arr_get a (base + off)
  if v > cur then float_arr_set a (base + off) v else 0.0

process lines acc rows =
  if lines == [] then rows
  else
    let line = head lines
    let rest = tail lines
    if line == "" then process rest acc rows
    else
      let f = split "," line
      let src = nth 0 f
      let prop = nth 1 f
      let mdot = parse_float (nth 2 f)
      let j = parse_float (nth 3 f)
      let ct = parse_float (nth 4 f)
      let sg = parse_float (nth 5 f)
      let uci = if prop == "argon" then uci_argon else uci_xenon
      let jci = j_ci (mdot / 1000.0) uci
      let xi = j / jci
      let ctm = maecker_ct
      let ctx = choueiri_ct mdot xi
      let rm = ctm - ct
      let rx = ctx - ct
      let z = rx / sg
      let g = group_of src prop mdot
      let base = g * 12
      let _ = acc_bump acc base 0 1.0
      let _ = acc_bump acc base 1 (rm * rm)
      let _ = acc_bump acc base 2 (rx * rx)
      let _ = acc_max acc base 3 (fabs rm)
      let _ = acc_max acc base 4 (fabs rx)
      let _ = acc_bump acc base 5 z
      let _ = if xi < 0.6 then
          let lx = log j
          let ly = log ct
          let _ = acc_bump acc base 6 1.0
          let _ = acc_bump acc base 7 lx
          let _ = acc_bump acc base 8 ly
          let _ = acc_bump acc base 9 (lx * ly)
          acc_bump acc base 10 (lx * lx)
        else 0.0
      let row = cat [src, ",", prop, ",", show_float mdot, ",", show_float j, ",",
                     show_float xi, ",", show_float ct, ",", show_float sg, ",",
                     show_float ctm, ",", show_float rm, ",",
                     show_float ctx, ",", show_float rx, ",", show_float z]
      process rest acc (cons row rows)

fmt3 v =
  -- show_float with 3-decimal rounding for the summary table
  let r = to_float (to_int (v * 1000.0 + (if v < 0.0 then 0.0 - 0.5 else 0.5))) / 1000.0
  show_float r

print_group acc g =
  let base = g * 12
  let n = float_arr_get acc (base + 0)
  if n < 1.0 then 0
  else
    let rms_m = sqrt (float_arr_get acc (base + 1) / n)
    let rms_x = sqrt (float_arr_get acc (base + 2) / n)
    let max_m = float_arr_get acc (base + 3)
    let max_x = float_arr_get acc (base + 4)
    let mean_z = float_arr_get acc (base + 5) / n
    let _ = print (cat ["  ", group_name g, "  n=", show (to_int n),
                        "  | maecker rms=", fmt3 rms_m, " max=", fmt3 max_m,
                        "  | xi rms=", fmt3 rms_x, " max=", fmt3 max_x,
                        " mean_z=", fmt3 mean_z])
    let nlo = float_arr_get acc (base + 6)
    if nlo > 2.0 then
      let sx = float_arr_get acc (base + 7)
      let sy = float_arr_get acc (base + 8)
      let sxy = float_arr_get acc (base + 9)
      let sxx = float_arr_get acc (base + 10)
      let slope = (nlo * sxy - sx * sy) / (nlo * sxx - sx * sx)
      print (cat ["      low-current (xi<0.6, n=", show (to_int nlo),
                  "): C_T ~ J^", fmt3 slope, "  (doc expects -3..-4)"])
    else 0

print_groups acc g =
  if g >= n_groups then 0
  else
    let _ = print_group acc g
    print_groups acc (g + 1)

main =
  let raw = read_file in_path
  let lines = tail (split "\n" raw)
  let acc = float_arr_new (n_groups * 12) 0.0
  let rows = reverse (process lines acc [])
  let hdr = "source,propellant,mdot_g_s,J_A,xi,C_T,sigma,ct_maecker,r_maecker,ct_xi,r_xi,z_xi\n"
  let _ = write_file out_path (cat [hdr, join "\n" rows, "\n"])
  let _ = print "phase1: baselines vs scoreboard"
  let _ = print (cat ["  maecker C_T = ", show_float maecker_ct,
                      "   ln(ra/rc) = ", show_float ln_ra_rc])
  let _ = print (cat ["  J_ci  Ar 1/3/6 g/s: ",
                      fmt3 (j_ci 0.001 uci_argon), " / ",
                      fmt3 (j_ci 0.003 uci_argon), " / ",
                      fmt3 (j_ci 0.006 uci_argon), " A"])
  let _ = print (cat ["  J_ci  Xe 3/6 g/s: ",
                      fmt3 (j_ci 0.003 uci_xenon), " / ",
                      fmt3 (j_ci 0.006 uci_xenon), " A"])
  let _ = print_groups acc 0
  let _ = print (cat ["  wrote ", out_path])
  0
